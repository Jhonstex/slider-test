<section class="page-header" style="--hero-width: {{ section.settings.header_width }}px; --page-header-bg: {{ section.settings.background }};">
  <div class="hero__intro">
    {% if section.settings.page_title != blank %}
      <h1 class="hero__page-title">{{ section.settings.page_title }}</h1>
    {% endif %}
    {% if section.settings.show_breadcrumb %}
      <nav class="hero__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ section.settings.home_link | default: routes.root_url }}">{{ section.settings.home_label }}</a>
        <span aria-hidden="true">|</span>
        <span>{{ section.settings.current_label }}</span>
      </nav>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "header_width", "label": "Content width", "min": 800, "max": 1440, "step": 10, "unit": "px", "default": 1410 },
    { "type": "text", "id": "page_title", "label": "Page title", "default": "About Us" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "home_label", "label": "Home breadcrumb label", "default": "Home" },
    { "type": "url", "id": "home_link", "label": "Home breadcrumb link" },
    { "type": "text", "id": "current_label", "label": "Current breadcrumb label", "default": "About Us" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}

