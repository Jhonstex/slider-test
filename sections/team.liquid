Output:
<section class="team section-spacing" style="--team-columns: {{ section.settings.columns }};">
  <div class="page-width">
    <div class="section-heading reveal"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.intro }}</p></div>
    <div class="team__grid">
      {% for block in section.blocks %}
        <article class="team-card reveal" {{ block.shopify_attributes }}>
          <div class="team-card__avatar">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 320, height: 320, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.name | escape }}{% elsif block.settings.image_url != blank %}<img src="{{ block.settings.image_url | escape }}" width="320" height="320" loading="lazy" alt="{{ block.settings.name | escape }}">{% else %}<span>{{ block.settings.name | slice: 0 }}</span>{% endif %}</div>
          <h3>{{ block.settings.name }}</h3><p class="team-card__role">{{ block.settings.role }}</p><div class="rte">{{ block.settings.bio }}</div>
          <nav class="team-card__socials" aria-label="Social links">
            <a href="{{ block.settings.facebook | default: routes.root_url }}" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 8h3V4h-3c-3.3 0-5 1.9-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.7.3-1 1-1Z" fill="currentColor"/></svg></a>
            <a href="{{ block.settings.twitter | default: routes.root_url }}" aria-label="Twitter"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19.7 7.1v.5c0 5.1-3.9 10.9-11 10.9-2.2 0-4.2-.6-5.9-1.7h.9c1.8 0 3.4-.6 4.7-1.6a3.9 3.9 0 0 1-3.6-2.7c.6.1 1.2.1 1.8-.1a3.9 3.9 0 0 1-3.1-3.8v-.1c.5.3 1.1.5 1.8.5A3.9 3.9 0 0 1 4 3.8a11 11 0 0 0 8 4.1 3.9 3.9 0 0 1 6.6-3.6 7.7 7.7 0 0 0 2.5-1 3.9 3.9 0 0 1-1.7 2.1 7.8 7.8 0 0 0 2.3-.6 8.3 8.3 0 0 1-2 2.3Z" fill="currentColor"/></svg></a>
            <a href="{{ block.settings.instagram | default: routes.root_url }}" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/></svg></a>
            <a href="{{ block.settings.youtube | default: routes.root_url }}" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z" fill="currentColor"/></svg></a>
          </nav>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Team",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Team" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The people behind the little joys." },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "4", "label": "Four" }, { "value": "3", "label": "Three" }, { "value": "2", "label": "Two" }], "default": "4" }
  ],
  "blocks": [
    { "type": "member", "name": "Team member", "settings": [
      { "type": "image_picker", "id": "image", "label": "Portrait" },
      { "type": "url", "id": "image_url", "label": "Portrait URL" },
      { "type": "text", "id": "name", "label": "Name", "default": "Name 01" },
      { "type": "text", "id": "role", "label": "Role", "default": "Personnel" },
      { "type": "richtext", "id": "bio", "label": "Bio", "default": "<p>Lorem ipsum dolor sit amet, sed do consectetur adipiscing elit.</p>" },
      { "type": "url", "id": "facebook", "label": "Facebook" },
      { "type": "url", "id": "twitter", "label": "Twitter" },
      { "type": "url", "id": "instagram", "label": "Instagram" },
      { "type": "url", "id": "youtube", "label": "YouTube" },
      { "type": "url", "id": "linkedin", "label": "LinkedIn" }
    ] }
  ],
  "presets": [{ "name": "Team", "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }, { "type": "member" }] }]
}
{% endschema %}

