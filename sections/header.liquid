{%- liquid
  assign helix_header_id = 'helix-header-' | append: section.id
  assign helix_logo_width = section.settings.logo_width | default: 110
  assign helix_mobile_logo_width = section.settings.mobile_logo_width | default: 90
  assign helix_logo_text = section.settings.logo_text | default: 'HELIX'
  assign helix_currency_code = localization.country.currency.iso_code | default: 'VND'
  assign helix_currency_symbol = localization.country.currency.symbol | default: '₫'
  assign helix_announcement_1 = section.settings.announcement_message_1 | default: 'Free shipping for all orders over 5.000.000₫'
  assign helix_announcement_2 = section.settings.announcement_message_2 | default: 'Receive 20% off your first order. Shop now'
  assign helix_emphasis_1 = section.settings.announcement_emphasis_1 | default: '5.000.000₫'
  assign helix_emphasis_2 = section.settings.announcement_emphasis_2
  assign helix_collections_url = routes.collections_url
  assign helix_women_url = section.settings.women_url
  if helix_women_url == blank
    assign helix_women_url = helix_collections_url | append: '/all-womens'
  endif
  assign helix_men_url = section.settings.men_url
  if helix_men_url == blank
    assign helix_men_url = helix_collections_url | append: '/all-mens'
  endif
  assign helix_find_shoes_url = section.settings.find_shoes_url | default: '/pages/find-your-shoes'
  assign helix_journal_url = section.settings.pages_journal_url | default: '/blogs/news'
  assign helix_womens_top_picks_url = helix_collections_url | append: '/womens-top-picks'
  assign helix_womens_best_sellers_url = section.settings.best_sellers_url
  if helix_womens_best_sellers_url == blank
    assign helix_womens_best_sellers_url = helix_collections_url | append: '/womens-best-sellers'
  endif
  assign helix_womens_trending_url = section.settings.trending_url
  if helix_womens_trending_url == blank
    assign helix_womens_trending_url = helix_collections_url | append: '/womens-trending'
  endif
  assign helix_womens_new_arrivals_url = helix_collections_url | append: '/womens-new-arrivals'
  assign helix_womens_sale_url = section.settings.sale_url
  if helix_womens_sale_url == blank
    assign helix_womens_sale_url = helix_collections_url | append: '/womens-on-sale'
  endif
  assign helix_mens_top_picks_url = helix_collections_url | append: '/mens-top-picks'
  assign helix_mens_best_sellers_url = section.settings.best_sellers_url
  if helix_mens_best_sellers_url == blank
    assign helix_mens_best_sellers_url = helix_collections_url | append: '/mens-best-sellers'
  endif
  assign helix_mens_trending_url = section.settings.trending_url
  if helix_mens_trending_url == blank
    assign helix_mens_trending_url = helix_collections_url | append: '/mens-trending'
  endif
  assign helix_mens_new_arrivals_url = helix_collections_url | append: '/mens-new-arrivals'
  assign helix_mens_sale_url = section.settings.sale_url
  if helix_mens_sale_url == blank
    assign helix_mens_sale_url = helix_collections_url | append: '/mens-on-sale'
  endif
  assign helix_trending_collection_url = section.settings.trending_url
  if helix_trending_collection_url == blank
    assign helix_trending_collection_url = helix_collections_url | append: '/trending'
  endif
  assign helix_best_sellers_collection_url = section.settings.best_sellers_url
  if helix_best_sellers_collection_url == blank
    assign helix_best_sellers_collection_url = helix_collections_url | append: '/best-sellers'
  endif
  assign helix_sale_collection_url = section.settings.sale_url
  if helix_sale_collection_url == blank
    assign helix_sale_collection_url = helix_collections_url | append: '/sale'
  endif
  assign helix_mobile_logo = section.settings.mobile_logo
  if helix_mobile_logo == blank
    assign helix_mobile_logo = section.settings.logo
  endif
  assign helix_mobile_transparent_logo = section.settings.mobile_transparent_logo
  if helix_mobile_transparent_logo == blank
    assign helix_mobile_transparent_logo = section.settings.transparent_logo
  endif
  if helix_mobile_transparent_logo == blank
    assign helix_mobile_transparent_logo = helix_mobile_logo
  endif
-%}

<div
  id="{{ helix_header_id }}"
  class="helix-header{% if section.settings.overlay_header %} helix-header--overlay{% endif %}{% if section.settings.sticky_header %} helix-header--sticky{% endif %}{% unless section.settings.show_announcement %} helix-header--no-announcement{% endunless %}"
  data-helix-header
  data-announcement-interval="{{ section.settings.announcement_interval | default: 5 | times: 1000 }}"
  style="
    --helix-overlay-text: {{ section.settings.overlay_text_color | default: '#ffffff' }};
    --helix-solid-text: {{ section.settings.solid_text_color | default: '#1e1e1e' }};
    --helix-announcement-bg: {{ section.settings.announcement_background | default: '#d3f285' }};
    --helix-announcement-text: {{ section.settings.announcement_text_color | default: '#1a1312' }};
    --helix-logo-width: {{ helix_logo_width }}px;
    --helix-mobile-logo-width: {{ helix_mobile_logo_width }}px;
  "
>
  {% if section.settings.show_announcement %}
    <div class="helix-header__announcement" data-helix-announcement role="region" aria-label="Announcements">
      <div class="helix-header__announcement-side helix-header__announcement-side--left">
        <button type="button" data-helix-announcement-prev aria-label="{{ 'header.previous_announcement' | t }}">
          <span aria-hidden="true">{% render 'helix-icon-chevron' %}</span>
        </button>
      </div>

      <div class="helix-header__announcement-track" aria-live="polite">
        <p class="helix-header__announcement-message is-active" data-helix-announcement-message>
          {% if helix_emphasis_1 != blank and helix_announcement_1 contains helix_emphasis_1 %}
            {% assign helix_announcement_1_prefix = helix_announcement_1 | split: helix_emphasis_1 | first %}
            {% assign helix_announcement_1_suffix = helix_announcement_1 | split: helix_emphasis_1 | last %}
            {{ helix_announcement_1_prefix }}<strong>{{ helix_emphasis_1 }}</strong>{{ helix_announcement_1_suffix }}
          {% else %}
            {{ helix_announcement_1 }}
          {% endif %}
        </p>
        {% if helix_announcement_2 != blank %}
          <p class="helix-header__announcement-message" data-helix-announcement-message>
            {% if helix_emphasis_2 != blank and helix_announcement_2 contains helix_emphasis_2 %}
              {% assign helix_announcement_2_prefix = helix_announcement_2 | split: helix_emphasis_2 | first %}
              {% assign helix_announcement_2_suffix = helix_announcement_2 | split: helix_emphasis_2 | last %}
              {{ helix_announcement_2_prefix }}<strong>{{ helix_emphasis_2 }}</strong>{{ helix_announcement_2_suffix }}
            {% else %}
              {{ helix_announcement_2 }}
            {% endif %}
          </p>
        {% endif %}
      </div>

      <div class="helix-header__announcement-side helix-header__announcement-side--right">
        <button type="button" data-helix-announcement-next aria-label="{{ 'header.next_announcement' | t }}">
          <span aria-hidden="true">{% render 'helix-icon-chevron' %}</span>
        </button>
      </div>
    </div>
  {% endif %}

  <div class="helix-header__desktop-bar" data-helix-desktop-bar>
    <div class="helix-header__desktop-surface">
      <div class="helix-header__desktop-inner">
        <nav class="helix-header__desktop-nav" aria-label="{{ 'header.primary_navigation' | t }}">
          <details class="helix-header__dropdown helix-header__dropdown--mega" data-helix-dropdown data-helix-hover-dropdown>
            <summary class="helix-header__nav-trigger" data-url="{{ helix_women_url }}">
              <span>{{ section.settings.women_label | default: 'Women' }}</span>
              <span class="helix-header__chevron" aria-hidden="true">{% render 'helix-icon-chevron' %}</span>
            </summary>
            <div class="helix-header__mega-panel" data-helix-mega-panel>
              <div class="helix-header__mega-inner">
                <div class="helix-header__mega-columns">
                  <div class="helix-header__mega-links-grid">
                    <div class="helix-header__mega-column">
                      <ul class="helix-header__mega-links" role="list">
                        <li><a href="{{ helix_womens_top_picks_url }}">Top picks</a></li>
                        <li><a href="{{ helix_womens_best_sellers_url }}">Best sellers</a></li>
                        <li><a href="{{ helix_womens_trending_url }}">Trending</a></li>
                        <li><a href="{{ helix_womens_new_arrivals_url }}">New arrivals</a></li>
                        <li><a href="{{ helix_womens_sale_url }}">On sale</a></li>
                      </ul>
                    </div>
                    <div class="helix-header__mega-column">
                      <p class="helix-header__mega-title">By activity</p>
                      <ul class="helix-header__mega-links" role="list">
                        <li><a href="{{ helix_collections_url }}/womens-hiking">Hiking</a></li>
                        <li><a href="{{ helix_collections_url }}/women-s-running">Running</a></li>
                        <li><a href="{{ helix_collections_url }}/women-s-training">Training</a></li>
                        <li><a href="{{ helix_collections_url }}/womens-tennis">Tennis</a></li>
                        <li><a href="{{ helix_collections_url }}/womens-lifestyle">Lifestyle</a></li>
                        <li><a href="{{ helix_women_url }}">Shop all</a></li>
                      </ul>
                    </div>
                    <div class="helix-header__mega-column">
                      <p class="helix-header__mega-title">By feature</p>
                      <ul class="helix-header__mega-links" role="list">
                        <li><a href="{{ helix_women_url }}?filter.p.m.custom.feature=Cushioned">Cushioned</a></li>
                        <li><a href="{{ helix_women_url }}?filter.p.m.custom.feature=Waterproof">Waterproof</a></li>
                        <li><a href="{{ helix_women_url }}?filter.p.m.custom.feature=Water-resistant">Water-resistant</a></li>
                        <li><a href="{{ helix_women_url }}?filter.p.m.custom.feature=Breathable">Breathable</a></li>
                        <li><a href="{{ helix_women_url }}?filter.p.m.custom.feature=Windproof">Windproof</a></li>
                      </ul>
                    </div>
                  </div>
                  <div class="helix-header__mega-banners">
                    <a class="helix-header__mega-promo" href="{{ helix_collections_url }}/womens-on-sale">
                      {% if section.settings.women_banner != blank %}
                        {{ section.settings.women_banner | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 991px) 24vw, 100vw', alt: section.settings.women_banner_title }}
                      {% else %}
                        {% # theme-check-disable RemoteAsset %}
                        <img src="https://helix-shoes-theme.myshopify.com/cdn/shop/files/banner_mega_menu_1.webp?v=1777884363&amp;width=900" width="900" height="604" loading="lazy" alt="">
                        {% # theme-check-enable RemoteAsset %}
                      {% endif %}
                      <span class="helix-header__mega-promo-content">
                        <strong>{% if section.settings.women_banner != blank %}{{ section.settings.women_banner_title | default: 'Find your favourites' }}{% else %}Women's sale{% endif %}</strong>
                        <span>{{ 'header.shop_now' | t }} ↗</span>
                      </span>
                    </a>
                    <a class="helix-header__mega-promo" href="{{ helix_women_url }}?sort_by=best-selling">
                      {% # theme-check-disable RemoteAsset %}
                      <img src="https://helix-shoes-theme.myshopify.com/cdn/shop/files/banner_mega_menu_2.webp?v=1777884363&amp;width=900" width="900" height="604" loading="lazy" alt="">
                      {% # theme-check-enable RemoteAsset %}
                      <span class="helix-header__mega-promo-content">
                        <strong>Women’s favorites</strong>
                        <span>{{ 'header.shop_now' | t }} ↗</span>
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </details>

          <details class="helix-header__dropdown helix-header__dropdown--mega" data-helix-dropdown data-helix-hover-dropdown>
            <summary class="helix-header__nav-trigger" data-url="{{ helix_men_url }}">
              <span>{{ section.settings.men_label | default: 'Men' }}</span>
              <span class="helix-header__chevron" aria-hidden="true">{% render 'helix-icon-chevron' %}</span>
            </summary>
            <div class="helix-header__mega-panel" data-helix-mega-panel>
              <div class="helix-header__mega-inner">
                <div class="helix-header__mega-columns">
                  <div class="helix-header__mega-links-grid">
                    <div class="helix-header__mega-column">
                      <ul class="helix-header__mega-links" role="list">
                      <li><a href="{{ helix_mens_top_picks_url }}">Top picks</a></li>
                      <li><a href="{{ helix_mens_best_sellers_url }}">Best sellers</a></li>
                      <li><a href="{{ helix_mens_trending_url }}">Trending</a></li>
                      <li><a href="{{ helix_mens_new_arrivals_url }}">New arrivals</a></li>
                      <li><a href="{{ helix_mens_sale_url }}">On sale</a></li>
                      </ul>
                    </div>
                    <div class="helix-header__mega-column">
                      <p class="helix-header__mega-title">By activity</p>
                      <ul class="helix-header__mega-links" role="list">
                      <li><a href="{{ helix_collections_url }}/mens-hiking">Hiking</a></li>
                      <li><a href="{{ helix_collections_url }}/mens-running">Running</a></li>
                      <li><a href="{{ helix_collections_url }}/mens-training">Training</a></li>
                      <li><a href="{{ helix_collections_url }}/mens-tennis">Tennis</a></li>
                      <li><a href="{{ helix_collections_url }}/mens-lifestyle">Lifestyle</a></li>
                      <li><a href="{{ helix_men_url }}">Shop all</a></li>
                      </ul>
                    </div>
                    <div class="helix-header__mega-column">
                      <p class="helix-header__mega-title">By feature</p>
                      <ul class="helix-header__mega-links" role="list">
                      <li><a href="{{ helix_men_url }}?filter.p.m.custom.feature=Cushioned">Cushioned</a></li>
                      <li><a href="{{ helix_men_url }}?filter.p.m.custom.feature=Waterproof">Waterproof</a></li>
                      <li><a href="{{ helix_men_url }}?filter.p.m.custom.feature=Water-resistant">Water-resistant</a></li>
                      <li><a href="{{ helix_men_url }}?filter.p.m.custom.feature=Breathable">Breathable</a></li>
                      <li><a href="{{ helix_men_url }}?filter.p.m.custom.feature=Windproof">Windproof</a></li>
                      </ul>
                    </div>
                  </div>
                  <div class="helix-header__mega-banners">
                    <a class="helix-header__mega-promo{% if section.settings.men_banner == blank %} helix-header__mega-promo--fallback{% endif %}" href="{{ helix_men_url }}">
                      {% if section.settings.men_banner != blank %}
                        {{ section.settings.men_banner | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 991px) 24vw, 100vw', alt: section.settings.men_banner_title }}
                      {% endif %}
                      <span class="helix-header__mega-promo-content">
                        <strong>{{ section.settings.men_banner_title | default: 'The everyday edit' }}</strong>
                        <span>{{ 'header.shop_now' | t }} ↗</span>
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </details>

          <details class="helix-header__dropdown helix-header__dropdown--pages" data-helix-dropdown data-helix-hover-dropdown>
            <summary class="helix-header__nav-trigger">
              <span>{{ section.settings.pages_label | default: 'Pages' }}</span>
              <span class="helix-header__chevron" aria-hidden="true">{% render 'helix-icon-chevron' %}</span>
            </summary>
            <div class="helix-header__pages-panel">
              <a href="{{ section.settings.pages_about_url | default: '/pages/about-us' }}">About us</a>
              <a href="{{ section.settings.pages_contact_url | default: '/pages/contact' }}">Contact</a>
              <a href="{{ section.settings.pages_faq_url | default: '/pages/faqs' }}">Faqs</a>
              <a href="{{ section.settings.pages_store_url | default: '/pages/store-locations' }}">Store locations</a>
              <a href="{{ section.settings.pages_recent_url | default: '/pages/recently-viewed' }}">Recently viewed</a>
              <a href="{{ helix_journal_url }}">Our journal</a>
            </div>
          </details>

          <a class="helix-header__nav-link" href="{{ helix_find_shoes_url }}">{{ section.settings.find_shoes_label | default: 'Find your shoes' }}</a>
        </nav>

        <a class="helix-header__brand" href="{{ routes.root_url }}" aria-label="{{ helix_logo_text }}">
          {% if section.settings.logo != blank %}
            <span class="helix-header__logo helix-header__logo--normal">
              {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', widths: '110,220,300', sizes: '110px', alt: helix_logo_text }}
            </span>
            <span class="helix-header__logo helix-header__logo--overlay" aria-hidden="true">
              {% if section.settings.transparent_logo != blank %}
                {{ section.settings.transparent_logo | image_url: width: 300 | image_tag: loading: 'eager', widths: '110,220,300', sizes: '110px', alt: '' }}
              {% else %}
                {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', widths: '110,220,300', sizes: '110px', alt: '' }}
              {% endif %}
            </span>
          {% else %}
            <span class="helix-header__logo helix-header__logo--normal">
              {% # theme-check-disable RemoteAsset %}
              <img src="https://helix-shoes-theme.myshopify.com/cdn/shop/files/logo.svg?v=1776243138&amp;width=220" width="110" height="19" loading="eager" alt="{{ helix_logo_text }}">
              {% # theme-check-enable RemoteAsset %}
            </span>
            <span class="helix-header__logo helix-header__logo--overlay" aria-hidden="true">
              {% # theme-check-disable RemoteAsset %}
              <img src="https://helix-shoes-theme.myshopify.com/cdn/shop/files/logo-white.svg?v=1776243137&amp;width=220" width="110" height="19" loading="eager" alt="">
              {% # theme-check-enable RemoteAsset %}
            </span>
          {% endif %}
        </a>

        <div class="helix-header__actions">
          <details class="helix-header__dropdown helix-header__dropdown--currency" data-helix-dropdown data-helix-hover-dropdown>
            <summary class="helix-header__currency-trigger">
              <span class="helix-header__country-flag" aria-hidden="true" style="--helix-country-flag: url(//cdn.shopify.com/static/images/flags/{{ localization.country.iso_code | default: 'VN' | downcase }}.svg?width=20);"></span>
              <span>{{ helix_currency_code }} {{ helix_currency_symbol }}</span>
              <span class="helix-header__chevron" aria-hidden="true">{% render 'helix-icon-chevron' %}</span>
            </summary>
            <div class="helix-header__currency-panel">
              <p class="helix-header__panel-label">{{ 'header.country_region' | t }}</p>
              <form action="{{ routes.localization_url }}" method="post" data-helix-localization-form>
                <input type="hidden" name="return_to" value="{{ request.path }}">
                <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-helix-country-value>
                <div class="helix-header__country-list">
                  {% for country in localization.available_countries %}
                    <button type="button" value="{{ country.iso_code }}" data-helix-country-option>
                      <span>{{ country.name }}</span>
                      <span>{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                    </button>
                  {% endfor %}
                </div>
              </form>
            </div>
          </details>
          <span class="helix-header__actions-divider" aria-hidden="true"></span>

          <a class="helix-header__icon-button" href="{{ routes.search_url }}" data-helix-open-search aria-label="{{ 'header.search' | t }}">
            {% render 'helix-icon-search' %}
            <span class="visually-hidden">{{ 'header.search' | t }}</span>
          </a>
          <a class="helix-header__icon-button helix-header__account-link" href="{{ routes.account_login_url }}" aria-label="{{ 'header.account' | t }}">
            {% render 'helix-icon-account' %}
            <span class="visually-hidden">{{ 'header.account' | t }}</span>
          </a>
          <a class="helix-header__icon-button helix-header__cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
            <span class="helix-header__cart-icon">
              {% render 'helix-icon-cart' %}
              {% if cart.item_count > 0 %}<span class="helix-header__cart-count">{{ cart.item_count }}</span>{% endif %}
            </span>
            <span class="visually-hidden">{{ 'header.cart' | t }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="helix-header__mobile-bar" data-helix-mobile-bar>
    <div class="helix-header__mobile-inner">
      <div class="helix-header__mobile-side helix-header__mobile-side--left">
        <button class="helix-header__mobile-icon" type="button" data-helix-mobile-open aria-expanded="false" aria-controls="{{ helix_header_id }}-mobile-menu" aria-label="{{ 'header.open_menu' | t }}">
          {% render 'helix-icon-menu' %}
        </button>
      </div>

      <a class="helix-header__brand helix-header__brand--mobile" href="{{ routes.root_url }}" aria-label="{{ helix_logo_text }}">
        {% if helix_mobile_logo != blank %}
          <span class="helix-header__logo helix-header__logo--normal">
            {{ helix_mobile_logo | image_url: width: 240 | image_tag: loading: 'eager', widths: '90,180,240', sizes: '90px', alt: helix_logo_text }}
          </span>
          <span class="helix-header__logo helix-header__logo--overlay" aria-hidden="true">
            {% if helix_mobile_transparent_logo != blank %}
              {{ helix_mobile_transparent_logo | image_url: width: 240 | image_tag: loading: 'eager', widths: '90,180,240', sizes: '90px', alt: '' }}
            {% else %}
              {{ helix_mobile_logo | image_url: width: 240 | image_tag: loading: 'eager', widths: '90,180,240', sizes: '90px', alt: '' }}
            {% endif %}
          </span>
        {% else %}
          <span class="helix-header__logo helix-header__logo--normal">
            {% # theme-check-disable RemoteAsset %}
            <img src="https://helix-shoes-theme.myshopify.com/cdn/shop/files/logo.svg?v=1776243138&amp;width=180" width="90" height="16" loading="eager" alt="{{ helix_logo_text }}">
            {% # theme-check-enable RemoteAsset %}
          </span>
          <span class="helix-header__logo helix-header__logo--overlay" aria-hidden="true">
            {% # theme-check-disable RemoteAsset %}
            <img src="https://helix-shoes-theme.myshopify.com/cdn/shop/files/logo-white.svg?v=1776243137&amp;width=180" width="90" height="16" loading="eager" alt="">
            {% # theme-check-enable RemoteAsset %}
          </span>
        {% endif %}
      </a>

      <div class="helix-header__mobile-side helix-header__mobile-side--right">
        <a class="helix-header__mobile-icon" href="{{ routes.search_url }}" data-helix-open-search aria-label="{{ 'header.search' | t }}">
          {% render 'helix-icon-search' %}
        </a>
        <a class="helix-header__mobile-icon helix-header__cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t }}">
          <span class="helix-header__cart-icon">
            {% render 'helix-icon-cart' %}
            {% if cart.item_count > 0 %}<span class="helix-header__cart-count">{{ cart.item_count }}</span>{% endif %}
          </span>
        </a>
      </div>
    </div>
  </div>

  <button class="helix-header__scrim" type="button" data-helix-close-layer aria-label="{{ 'general.close' | t }}"></button>

  <div class="helix-header__mobile-menu" id="{{ helix_header_id }}-mobile-menu" data-helix-mobile-menu aria-hidden="true">
    <div class="helix-header__mobile-menu-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}" tabindex="-1">
      <div class="helix-header__mobile-menu-top">
        <strong>{{ 'header.menu' | t }}</strong>
        <button class="helix-header__close-button" type="button" data-helix-close-mobile aria-label="{{ 'general.close' | t }}">
          {% render 'helix-icon-close' %}
        </button>
      </div>
      <nav class="helix-header__mobile-nav" aria-label="{{ 'header.primary_navigation' | t }}">
        <details>
          <summary><span>{{ section.settings.women_label | default: 'Women' }}</span><span aria-hidden="true">{% render 'helix-icon-chevron' %}</span></summary>
          <div class="helix-header__mobile-submenu">
            <a href="{{ helix_womens_top_picks_url }}">Top picks</a>
            <a href="{{ helix_womens_best_sellers_url }}">Best sellers</a>
            <a href="{{ helix_womens_trending_url }}">Trending</a>
            <a href="{{ helix_womens_new_arrivals_url }}">New arrivals</a>
            <a href="{{ helix_womens_sale_url }}">On sale</a>
            <a href="{{ helix_collections_url }}/womens-hiking">Hiking</a>
            <a href="{{ helix_collections_url }}/women-s-running">Running</a>
            <a href="{{ helix_collections_url }}/women-s-training">Training</a>
            <a href="{{ helix_collections_url }}/womens-tennis">Tennis</a>
            <a href="{{ helix_women_url }}">Shop all</a>
          </div>
        </details>
        <details>
          <summary><span>{{ section.settings.men_label | default: 'Men' }}</span><span aria-hidden="true">{% render 'helix-icon-chevron' %}</span></summary>
          <div class="helix-header__mobile-submenu">
            <a href="{{ helix_mens_top_picks_url }}">Top picks</a>
            <a href="{{ helix_mens_best_sellers_url }}">Best sellers</a>
            <a href="{{ helix_mens_trending_url }}">Trending</a>
            <a href="{{ helix_mens_new_arrivals_url }}">New arrivals</a>
            <a href="{{ helix_mens_sale_url }}">On sale</a>
            <a href="{{ helix_collections_url }}/mens-hiking">Hiking</a>
            <a href="{{ helix_collections_url }}/mens-running">Running</a>
            <a href="{{ helix_collections_url }}/mens-training">Training</a>
            <a href="{{ helix_collections_url }}/mens-tennis">Tennis</a>
            <a href="{{ helix_men_url }}">Shop all</a>
          </div>
        </details>
        <details>
          <summary><span>{{ section.settings.pages_label | default: 'Pages' }}</span><span aria-hidden="true">{% render 'helix-icon-chevron' %}</span></summary>
          <div class="helix-header__mobile-submenu">
            <a href="{{ section.settings.pages_about_url | default: '/pages/about-us' }}">About us</a>
            <a href="{{ section.settings.pages_contact_url | default: '/pages/contact' }}">Contact</a>
            <a href="{{ section.settings.pages_faq_url | default: '/pages/faqs' }}">Faqs</a>
            <a href="{{ section.settings.pages_store_url | default: '/pages/store-locations' }}">Store locations</a>
            <a href="{{ section.settings.pages_recent_url | default: '/pages/recently-viewed' }}">Recently viewed</a>
            <a href="{{ helix_journal_url }}">Our journal</a>
          </div>
        </details>
        <a href="{{ helix_find_shoes_url }}">{{ section.settings.find_shoes_label | default: 'Find your shoes' }}</a>
        <a href="{{ routes.account_login_url }}">{{ 'header.account' | t }}</a>
        <details>
          <summary><span>{{ helix_currency_code }} {{ helix_currency_symbol }}</span><span aria-hidden="true">{% render 'helix-icon-chevron' %}</span></summary>
          <div class="helix-header__mobile-submenu">
            {% for country in localization.available_countries %}
              <button type="button" value="{{ country.iso_code }}" data-helix-country-option>{{ country.name }} <span>{{ country.currency.iso_code }} {{ country.currency.symbol }}</span></button>
            {% endfor %}
          </div>
        </details>
      </nav>
    </div>
  </div>

  <div class="helix-header__drawer helix-header__drawer--search" data-helix-search-drawer aria-hidden="true">
    <div class="helix-header__drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.search' | t }}" tabindex="-1">
      <div class="helix-header__drawer-top">
        <strong>{{ 'header.search' | t }}</strong>
        <button class="helix-header__close-button" type="button" data-helix-close-layer aria-label="{{ 'general.close' | t }}">{% render 'helix-icon-close' %}</button>
      </div>
      <form action="{{ routes.search_url }}" method="get" class="helix-header__search-form">
        <label class="visually-hidden" for="{{ helix_header_id }}-search">{{ 'header.search' | t }}</label>
        <input id="{{ helix_header_id }}-search" type="search" name="q" placeholder="What are you looking for?" autocomplete="off">
        <button type="submit" aria-label="{{ 'header.search' | t }}">{% render 'helix-icon-search' %}</button>
      </form>
      <p class="helix-header__drawer-note">{{ 'header.popular_searches' | t }}</p>
      <div class="helix-header__search-links">
        <a href="{{ helix_trending_collection_url }}">{{ 'header.trending' | t }}</a>
        <a href="{{ helix_best_sellers_collection_url }}">{{ 'header.best_sellers' | t }}</a>
        <a href="{{ helix_sale_collection_url }}">{{ 'header.on_sale' | t }}</a>
      </div>
    </div>
  </div>

  <div class="helix-header__drawer helix-header__drawer--cart" data-helix-cart-drawer aria-hidden="true">
    <div class="helix-header__drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.cart' | t }}" tabindex="-1">
      <div class="helix-header__drawer-top">
        <strong>{{ 'header.cart' | t }}</strong>
        <button class="helix-header__close-button" type="button" data-helix-close-layer aria-label="{{ 'general.close' | t }}">{% render 'helix-icon-close' %}</button>
      </div>
      {% if cart.item_count > 0 %}
        <p class="helix-header__cart-message">{{ cart.item_count }} {{ 'header.items_in_cart' | t }}</p>
        <div class="helix-header__cart-total">{{ cart.total_price | money }}</div>
        <a class="helix-header__drawer-button helix-header__drawer-button--dark" href="{{ routes.cart_url }}">{{ 'header.view_cart' | t }}</a>
        {% if additional_checkout_buttons %}{{ content_for_additional_checkout_buttons }}{% endif %}
      {% else %}
        <p class="helix-header__cart-message">{{ 'header.empty_cart' | t }}</p>
        <a class="helix-header__drawer-button" href="{{ routes.all_products_collection_url }}">{{ 'header.shop' | t }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap');

  #{{ helix_header_id }} {
    --helix-font: 'Figtree', {% if section.settings.font_family != blank %}{{ section.settings.font_family.family }}, {{ section.settings.font_family.fallback_families }}{% else %}'Open Sans', Arial, sans-serif{% endif %};
  }
{% endstyle %}

{% stylesheet %}
  .helix-header,
  .helix-header * {
    box-sizing: border-box;
  }

  .helix-header {
    position: relative;
    z-index: 30;
    color: var(--helix-solid-text);
    font-family: var(--helix-font, 'Figtree', 'Open Sans', Arial, sans-serif);
    font-size: 14px;
    line-height: 1.6;
  }

  .helix-header button,
  .helix-header input {
    color: inherit;
    font: inherit;
  }

  .helix-header button,
  .helix-header summary {
    cursor: pointer;
  }

  .helix-header a {
    color: inherit;
    text-decoration: none;
  }

  .helix-header__announcement {
    display: grid;
    min-height: 38.4px;
    grid-template-columns: 32px minmax(0, 700px) 32px;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    overflow: hidden;
    background: var(--helix-announcement-bg);
    color: var(--helix-announcement-text);
    font-size: 14px;
    line-height: 22.4px;
  }

  .helix-header__announcement-track {
    position: relative;
    grid-column: 2;
    width: 100%;
    min-width: 0;
    height: 22.4px;
    min-height: 22.4px;
    overflow: hidden;
    text-align: center;
  }

  .helix-header__announcement-message {
    position: absolute;
    inset: 0;
    margin: 0;
    width: 100%;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(7px);
    transition: opacity .2s cubic-bezier(.6, .14, 0, 1), transform .3s cubic-bezier(.6, .14, 0, 1);
    pointer-events: none;
  }

  .helix-header__announcement-message.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .helix-header__announcement-message strong {
    font-weight: 700;
  }

  .helix-header__announcement-side {
    display: flex;
    width: 32px;
    height: 38.4px;
    align-items: center;
    justify-content: center;
  }

  .helix-header__announcement-side--right {
    grid-column: 3;
  }

  .helix-header__announcement-side button {
    display: grid;
    width: 32px;
    height: 32px;
    padding: 0;
    place-items: center;
    border: 0;
    background: transparent;
    font-size: 18px;
    line-height: 1;
    transition: transform .2s ease, opacity .2s ease;
  }

  .helix-header__announcement-side--left {
    grid-column: 1;
  }

  .helix-header__announcement-side--left button span {
    display: inline-flex;
    transform: rotate(90deg);
  }

  .helix-header__announcement-side--right button span {
    display: inline-flex;
    transform: rotate(-90deg);
  }

  .helix-header__announcement-side button svg {
    width: 24px;
    height: 24px;
  }

  .helix-header__announcement-side button:hover,
  .helix-header__announcement-side button:focus-visible {
    transform: translateX(3px);
    opacity: .62;
  }

  .helix-header__announcement-side--left button:hover,
  .helix-header__announcement-side--left button:focus-visible {
    transform: translateX(-3px);
  }

  .helix-header__desktop-bar,
  .helix-header__mobile-bar {
    position: absolute;
    z-index: 3;
    top: 39px;
    right: 0;
    left: 0;
    color: var(--helix-solid-text);
  }

  .helix-header--no-announcement .helix-header__desktop-bar,
  .helix-header--no-announcement .helix-header__mobile-bar {
    top: 0;
  }

  .helix-header__desktop-surface,
  .helix-header__mobile-inner {
    background: transparent;
    transition: background-color .2s cubic-bezier(.6, 0, .4, 1), box-shadow .2s cubic-bezier(.6, 0, .4, 1), color .2s cubic-bezier(.6, 0, .4, 1);
  }

  .helix-header__desktop-inner {
    display: grid;
    width: 100%;
    min-height: 80px;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    padding-inline: clamp(30px, 3.94vw, 50px);
  }

  .helix-header__desktop-nav,
  .helix-header__actions {
    display: flex;
    min-width: 0;
    align-items: center;
  }

  .helix-header__desktop-nav {
    justify-content: flex-start;
    gap: 0;
  }

  .helix-header__actions {
    justify-content: flex-end;
    gap: 0;
  }

  .helix-header__brand {
    position: relative;
    z-index: 2;
    display: inline-flex;
    width: var(--helix-logo-width);
    min-width: var(--helix-logo-width);
    height: auto;
    align-items: center;
    justify-content: center;
    justify-self: center;
    line-height: 1;
  }

  .helix-header__brand--mobile {
    width: var(--helix-mobile-logo-width);
    min-width: var(--helix-mobile-logo-width);
  }

  .helix-header__logo,
  .helix-header__logo-text {
    display: block;
    width: 100%;
    line-height: 1;
  }

  .helix-header__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .helix-header__logo--overlay,
  .helix-header__logo-text--overlay {
    position: absolute;
    inset: 0;
    display: none;
  }

  .helix-header__logo-text {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -.03em;
    text-align: center;
    white-space: nowrap;
  }

  .helix-header__nav-trigger,
  .helix-header__currency-trigger,
  .helix-header__nav-link {
    position: relative;
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border: 0;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 22.4px;
    white-space: nowrap;
  }

  .helix-header__nav-trigger::after,
  .helix-header__nav-link::after,
  .helix-header__currency-trigger::after {
    position: absolute;
    right: 12px;
    bottom: 1px;
    left: 12px;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: .85;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform .2s cubic-bezier(.6, 0, .4, 1);
  }

  .helix-header__nav-trigger:hover::after,
  .helix-header__nav-trigger:focus-visible::after,
  .helix-header__nav-link:hover::after,
  .helix-header__nav-link:focus-visible::after,
  .helix-header__dropdown[open] > .helix-header__nav-trigger::after,
  .helix-header__currency-trigger:hover::after,
  .helix-header__currency-trigger:focus-visible::after,
  .helix-header__dropdown[open] > .helix-header__currency-trigger::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .helix-header__chevron {
    display: inline-flex;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    transition: transform .3s cubic-bezier(.6, .14, 0, 1);
  }

  .helix-header__chevron svg {
    width: 20px;
    height: 20px;
  }

  .helix-header__dropdown[open] > summary .helix-header__chevron {
    transform: rotate(180deg);
  }

  .helix-header__dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .helix-header__dropdown > summary {
    list-style: none;
  }

  .helix-header__dropdown {
    position: static;
  }

  .helix-header__dropdown--pages,
  .helix-header__dropdown--currency {
    position: relative;
  }

  .helix-header__currency-trigger {
    min-height: 32px;
    gap: 8px;
    padding-inline: 0;
    font-weight: 400;
  }

  .helix-header__currency-trigger .helix-header__chevron,
  .helix-header__currency-trigger .helix-header__chevron svg {
    width: 16px;
    height: 16px;
  }

  .helix-header__country-flag {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    background: var(--helix-country-flag) center / contain no-repeat;
  }

  .helix-header__actions-divider {
    width: 1px;
    height: 16px;
    flex: 0 0 1px;
    margin-right: 10px;
    border-right: 1px solid #e5e5e5;
  }

  .helix-header__dropdown--currency {
    margin-right: 20px;
  }

  .helix-header__icon-button {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    transition: transform .25s ease, opacity .25s ease;
  }

  .helix-header__icon-button:hover,
  .helix-header__icon-button:focus-visible {
    opacity: .62;
    transform: translateY(-1px);
  }

  .helix-header__icon-button svg {
    width: 24px;
    height: 24px;
  }

  .helix-header__cart-icon {
    position: relative;
    display: inline-flex;
  }

  .helix-header__cart-count {
    position: absolute;
    top: -7px;
    right: -8px;
    display: grid;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    place-items: center;
    border-radius: 50%;
    background: currentColor;
    color: var(--helix-announcement-bg);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
  }

  .helix-header__mega-panel {
    position: absolute;
    z-index: 8;
    top: 100%;
    right: 0;
    left: 0;
    height: var(--helix-mega-height, 0px);
    max-height: min(540px, calc(100vh - 80px));
    overflow: hidden;
    border-top: 1px solid transparent;
    background: #fff;
    color: #1a1312;
    opacity: 0;
    pointer-events: none;
    transform: none;
    transition: height .3s cubic-bezier(.6, .14, 0, 1), border-color .3s cubic-bezier(.6, .14, 0, 1) .1s, opacity .2s cubic-bezier(.6, .14, 0, 1), visibility 0s linear .3s;
    visibility: hidden;
  }

  .helix-header__dropdown[open] > .helix-header__mega-panel {
    height: var(--helix-mega-height, min(540px, calc(100vh - 80px)));
    border-color: rgba(26, 19, 18, .12);
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
    visibility: visible;
  }

  .helix-header__mega-inner {
    width: 100%;
    margin-inline: auto;
    padding: 40px clamp(30px, 3.94vw, 50px);
  }

  .helix-header__mega-columns {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }

  .helix-header__mega-links-grid {
    display: grid;
    width: 600px;
    flex: 0 0 600px;
    grid-template-columns: repeat(3, 200px);
  }

  .helix-header__mega-banners {
    display: grid;
    min-width: 0;
    flex: 0 1 907px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .helix-header__mega-column,
  .helix-header__mega-promo {
    opacity: 0;
    transform: translateY(10px);
  }

  .helix-header__dropdown[open] .helix-header__mega-column,
  .helix-header__dropdown[open] .helix-header__mega-promo {
    animation: helix-menu-reveal .4s ease forwards;
  }

  .helix-header__dropdown[open] .helix-header__mega-column:nth-child(1) { animation-delay: .2s; }
  .helix-header__dropdown[open] .helix-header__mega-column:nth-child(2) { animation-delay: .25s; }
  .helix-header__dropdown[open] .helix-header__mega-column:nth-child(3) { animation-delay: .3s; }
  .helix-header__dropdown[open] .helix-header__mega-promo { animation-delay: .35s; }

  .helix-header__mega-title,
  .helix-header__panel-label {
    margin: 0 0 16px;
    color: #131313;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 22.4px;
  }

  .helix-header__mega-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .helix-header__mega-links a,
  .helix-header__pages-panel a {
    position: relative;
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    padding-block: 0;
    font-size: 14px;
    line-height: 22.4px;
    transition: color .2s ease;
  }

  .helix-header__mega-links a::after,
  .helix-header__pages-panel a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform .2s cubic-bezier(.6, 0, .4, 1);
  }

  .helix-header__mega-links a:hover::after,
  .helix-header__mega-links a:focus-visible::after,
  .helix-header__pages-panel a:hover::after,
  .helix-header__pages-panel a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .helix-header__mega-column:first-child .helix-header__mega-links a {
    font-size: 16px;
    font-weight: 700;
    line-height: 25.6px;
  }

  .helix-header__mega-links a:hover,
  .helix-header__mega-links a:focus-visible,
  .helix-header__pages-panel a:hover,
  .helix-header__pages-panel a:focus-visible {
    color: rgba(26, 19, 18, .55);
  }

  .helix-header__mega-promo {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 16px;
    color: #1a1312;
  }

  .helix-header__mega-promo img {
    display: block;
    width: 100%;
    aspect-ratio: 1.49;
    height: auto;
    border-radius: 16px;
    object-fit: cover;
    transition: transform .55s cubic-bezier(.6, .14, 0, 1);
  }

  .helix-header__mega-promo:hover img {
    transform: scale(1.02);
  }

  .helix-header__mega-promo--fallback {
    display: none;
  }

  .helix-header__mega-promo-content {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 8px;
  }

  .helix-header__mega-promo-content strong {
    font-size: 16px;
    font-weight: 700;
    line-height: 25.6px;
  }

  .helix-header__mega-promo-content span {
    font-size: 14px;
    line-height: 22.4px;
  }

  .helix-header__pages-panel,
  .helix-header__currency-panel {
    position: absolute;
    z-index: 9;
    top: calc(100% + 6px);
    right: 0;
    width: max-content;
    min-width: 210px;
    padding: 15px;
    border: 1px solid rgba(26, 19, 18, .12);
    background: rgba(255, 255, 255, .98);
    box-shadow: 0 16px 40px rgba(26, 19, 18, .12);
    color: #1a1312;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-7px);
    transition: opacity .2s cubic-bezier(.6, .14, 0, 1), transform .3s cubic-bezier(.6, .14, 0, 1), visibility 0s linear .3s;
    visibility: hidden;
  }

  .helix-header__dropdown[open] > .helix-header__pages-panel,
  .helix-header__dropdown[open] > .helix-header__currency-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
    visibility: visible;
  }

  .helix-header__pages-panel {
    left: 0;
    right: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .helix-header__country-list {
    display: flex;
    max-height: 260px;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
  }

  .helix-header__country-list button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 18px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    font-size: 13px;
    text-align: left;
  }

  .helix-header__country-list button span:last-child {
    color: rgba(26, 19, 18, .55);
    white-space: nowrap;
  }

  .helix-header__country-list button:hover,
  .helix-header__country-list button:focus-visible {
    color: rgba(26, 19, 18, .55);
  }

  .helix-header__scrim,
