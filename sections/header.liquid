{% javascript %}
  (() => {
    const initHelixHeader = (root) => {
      if (!root || root.dataset.helixReady === 'true') return;
      root.dataset.helixReady = 'true';

    const select = (selector, scope = root) => scope.querySelector(selector);
    const selectAll = (selector, scope = root) => Array.from(scope.querySelectorAll(selector));
    const desktopQuery = window.matchMedia('(min-width: 991px)');
    const dropdowns = selectAll('[data-helix-dropdown]');
    const mobileMenu = select('[data-helix-mobile-menu]');
    const searchDrawer = select('[data-helix-search-drawer]');
    const cartDrawer = select('[data-helix-cart-drawer]');
    const mobileMenuPanel = select('.helix-header__mobile-menu-panel');
    const searchPanel = select('.helix-header__drawer--search .helix-header__drawer-panel');
    const cartPanel = select('.helix-header__drawer--cart .helix-header__drawer-panel');
    let announcementIndex = 0;
    let announcementTimer;
    let closeDropdownTimer;
    let lastScrollY = window.scrollY;

    const setBodyLock = () => {
      const locked = root.classList.contains('is-mobile-menu-open') || root.classList.contains('is-search-open') || root.classList.contains('is-cart-open');
      document.documentElement.classList.toggle('helix-header-lock', locked);
    };

    const closeDropdowns = () => {
      dropdowns.forEach((dropdown) => {
        dropdown.open = false;
      });
      root.classList.remove('is-menu-open');
      window.setTimeout(syncDropdownState, 0);
    };

    const openLayer = (name) => {
      closeDropdowns();
      root.classList.remove('is-mobile-menu-open', 'is-search-open', 'is-cart-open');
      const target = name === 'mobile' ? mobileMenu : name === 'search' ? searchDrawer : cartDrawer;
      const panel = name === 'mobile' ? mobileMenuPanel : name === 'search' ? searchPanel : cartPanel;
      if (!target) return;
      root.classList.add(`is-${name}-open`);
      target.setAttribute('aria-hidden', 'false');
      panel?.focus({ preventScroll: true });
      setBodyLock();
      if (name === 'search') select('input[type="search"]', searchDrawer)?.focus({ preventScroll: true });
    };

    const closeLayers = () => {
      root.classList.remove('is-mobile-menu-open', 'is-search-open', 'is-cart-open');
      [mobileMenu, searchDrawer, cartDrawer].forEach((layer) => layer?.setAttribute('aria-hidden', 'true'));
      setBodyLock();
    };

    const syncMegaPanelHeight = (dropdown) => {
      const panel = select('[data-helix-mega-panel]', dropdown);
      if (!panel) return;
      if (!dropdown.open) {
        panel.style.setProperty('--helix-mega-height', '0px');
        return;
      }
      const maxHeight = Math.max(0, window.innerHeight - 80);
      panel.style.setProperty('--helix-mega-height', `${Math.min(panel.scrollHeight, maxHeight)}px`);
    };

    const syncDropdownState = () => {
      const open = dropdowns.some((dropdown) => dropdown.open);
      root.classList.toggle('is-menu-open', open);
      dropdowns.forEach(syncMegaPanelHeight);
    };

    dropdowns.forEach((dropdown) => {
      const summary = select('summary', dropdown);
      dropdown.addEventListener('toggle', syncDropdownState);

      summary?.addEventListener('click', () => {
        const url = summary.dataset.url;
        if (url && url !== '#') {
          window.location.href = url;
          return;
        }
        window.setTimeout(syncDropdownState, 0);
      });

      dropdown.addEventListener('pointerenter', () => {
        if (!desktopQuery.matches || !dropdown.hasAttribute('data-helix-hover-dropdown')) return;
        window.clearTimeout(closeDropdownTimer);
        dropdowns.forEach((item) => {
          if (item !== dropdown) item.open = false;
        });
        dropdown.open = true;
        syncDropdownState();
      });

      dropdown.addEventListener('pointerleave', () => {
        if (!desktopQuery.matches || !dropdown.hasAttribute('data-helix-hover-dropdown')) return;
        closeDropdownTimer = window.setTimeout(() => {
          if (!dropdown.matches(':hover')) {
            dropdown.open = false;
            syncDropdownState();
          }
        }, 120);
      });
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) {
        closeDropdowns();
        closeLayers();
      }
    });

    root.addEventListener('click', (event) => {
      const searchTrigger = event.target.closest('[data-helix-open-search]');
      const mobileTrigger = event.target.closest('[data-helix-mobile-open]');
      const closeTrigger = event.target.closest('[data-helix-close-layer], [data-helix-close-mobile]');
      const countryOption = event.target.closest('[data-helix-country-option]');

      if (searchTrigger) {
        event.preventDefault();
        openLayer('search');
      }

      if (mobileTrigger) {
        event.preventDefault();
        openLayer('mobile');
        mobileTrigger.setAttribute('aria-expanded', 'true');
      }

      if (closeTrigger) {
        event.preventDefault();
        closeLayers();
        select('[data-helix-mobile-open]')?.setAttribute('aria-expanded', 'false');
      }

      if (countryOption) {
        const value = countryOption.value;
        const countryValue = select('[data-helix-country-value]');
        const localizationForm = select('[data-helix-localization-form]');
        if (countryValue && localizationForm && value) {
          countryValue.value = value;
          localizationForm.submit();
        }
      }
    });

    select('[data-helix-announcement-prev]')?.addEventListener('click', () => showAnnouncement(announcementIndex - 1, -1));
    select('[data-helix-announcement-next]')?.addEventListener('click', () => showAnnouncement(announcementIndex + 1, 1));

    function showAnnouncement(index, direction = 1) {
      const messages = selectAll('[data-helix-announcement-message]');
      if (messages.length < 2) return;
      announcementIndex = (index + messages.length) % messages.length;
      messages.forEach((message, messageIndex) => {
        message.classList.toggle('is-active', messageIndex === announcementIndex);
        message.style.setProperty('--helix-announcement-direction', direction > 0 ? '1' : '-1');
      });
      restartAnnouncementTimer();
    }

    function restartAnnouncementTimer() {
      window.clearInterval(announcementTimer);
      const messages = selectAll('[data-helix-announcement-message]');
      if (messages.length < 2) return;
      announcementTimer = window.setInterval(() => showAnnouncement(announcementIndex + 1, 1), Number(root.dataset.announcementInterval) || 5000);
    }

    function updateScrollState() {
      if (!root.classList.contains('helix-header--sticky')) return;
      const currentScrollY = window.scrollY;
      root.classList.toggle('is-scrolled', currentScrollY > 8);
      if (!desktopQuery.matches) {
        if (currentScrollY > lastScrollY + 3 && currentScrollY > 80) root.classList.add('is-scroll-hidden');
        if (currentScrollY < lastScrollY - 3 || currentScrollY <= 8) root.classList.remove('is-scroll-hidden');
      } else {
        root.classList.remove('is-scroll-hidden');
      }
      lastScrollY = currentScrollY;
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeDropdowns();
      closeLayers();
      select('[data-helix-mobile-open]')?.setAttribute('aria-expanded', 'false');
    });

    window.addEventListener('scroll', updateScrollState, { passive: true });
    window.addEventListener('resize', () => {
      if (desktopQuery.matches) root.classList.remove('is-scroll-hidden');
      syncDropdownState();
    });

    restartAnnouncementTimer();
      updateScrollState();
    };

    const bootHelixHeaders = () => {
      document.querySelectorAll('[data-helix-header]').forEach(initHelixHeader);
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootHelixHeaders);
    else bootHelixHeaders();
    document.addEventListener('shopify:section:load', bootHelixHeaders);
  })();
{% endjavascript %}

