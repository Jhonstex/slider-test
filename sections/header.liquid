            <div>
              <a href="{{ section.settings.men_url }}">Hiking</a>
              <a href="{{ section.settings.men_url }}">Running</a>
              <a href="{{ section.settings.men_url }}">Training</a>
              <a href="{{ section.settings.men_url }}">Tennis</a>
              <a href="{{ section.settings.men_url }}">Lifestyle</a>
              <a href="{{ section.settings.men_url }}">Shop all</a>
            </div>
          </details>
          <details>
            <summary>{{ 'header.by_feature' | t }}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg></summary>
            <div>
              <a href="{{ section.settings.men_url }}">Cushioned</a>
              <a href="{{ section.settings.men_url }}">Waterproof</a>
              <a href="{{ section.settings.men_url }}">Water-resistant</a>
              <a href="{{ section.settings.men_url }}">Breathable</a>
              <a href="{{ section.settings.men_url }}">Windproof</a>
            </div>
          </details>
        </div>
      </div>

      <div class="helix-mobile-view" data-helix-mobile-view="pages" hidden>
        <div class="helix-mobile-view__top">
          <button class="helix-mobile-back" type="button" data-helix-mobile-view-open="top" aria-label="{{ 'general.back' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg>
            <span>{{ section.settings.pages_label }}</span>
          </button>
          <button class="helix-icon-button" type="button" data-helix-mobile-close aria-label="{{ 'general.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
          </button>
        </div>
        <nav class="helix-mobile-sub-links">
          <a href="{{ section.settings.pages_about_url }}">About us</a>
          <a href="{{ section.settings.pages_contact_url }}">Contact</a>
          <a href="{{ section.settings.pages_faq_url }}">Faqs</a>
          <a href="{{ section.settings.pages_store_url }}">Store locations</a>
          <a href="{{ section.settings.pages_recent_url }}">Recently viewed</a>
          <a href="{{ section.settings.pages_journal_url }}">Our journal</a>
        </nav>
      </div>

      <div class="helix-mobile-view" data-helix-mobile-view="currency" hidden>
        <div class="helix-mobile-view__top">
          <button class="helix-mobile-back" type="button" data-helix-mobile-view-open="top" aria-label="{{ 'general.back' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg>
            <span>{{ 'header.country_region' | t }}</span>
          </button>
          <button class="helix-icon-button" type="button" data-helix-mobile-close aria-label="{{ 'general.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
          </button>
        </div>
        {% form 'localization', id: helix_mobile_currency_form_id %}
          <div class="helix-mobile-country-list">
            {% if localization.available_countries != blank %}
              {% for country in localization.available_countries limit: 10 %}
                <button type="submit" name="country_code" value="{{ country.iso_code }}">
                  <span>{{ country.iso_code }}</span>
                  <span>{{ country.name }}</span>
                  <span>{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                </button>
              {% endfor %}
            {% endif %}
          </div>
        {% endform %}
      </div>

      <div class="helix-mobile-view" data-helix-mobile-view="language" hidden>
        <div class="helix-mobile-view__top">
          <button class="helix-mobile-back" type="button" data-helix-mobile-view-open="top" aria-label="{{ 'general.back' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg>
            <span>{{ 'header.language' | t }}</span>
          </button>
          <button class="helix-icon-button" type="button" data-helix-mobile-close aria-label="{{ 'general.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
          </button>
        </div>
        {% form 'localization', id: helix_mobile_language_form_id %}
          <div class="helix-mobile-language-list">
            {% if localization.available_languages != blank %}
              {% for language in localization.available_languages %}
                <button type="submit" name="language_code" value="{{ language.iso_code }}">
                  <span>{{ language.endonym_name }}</span>
                  <span aria-hidden="true">→</span>
                </button>
              {% endfor %}
            {% else %}
              <button type="submit" name="language_code" value="en"><span>English</span><span aria-hidden="true">→</span></button>
            {% endif %}
          </div>
        {% endform %}
      </div>
    </aside>
  </div>

  <aside class="helix-drawer" data-helix-drawer="search" role="dialog" aria-modal="true" aria-labelledby="HelixSearchTitle-{{ section.id }}" hidden>
    <div class="helix-drawer__top">
      <h2 id="HelixSearchTitle-{{ section.id }}">{{ 'header.search' | t }}</h2>
      <button class="helix-icon-button" type="button" data-helix-drawer-close aria-label="{{ 'general.close' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
      </button>
    </div>
    <form class="helix-search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="HelixSearchInput-{{ section.id }}">{{ 'header.search' | t }}</label>
      <input id="HelixSearchInput-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" autocomplete="off">
      <button type="submit" aria-label="{{ 'header.search' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      </button>
    </form>
    <div class="helix-drawer__section">
      <p class="helix-drawer__eyebrow">{{ 'header.popular_searches' | t }}</p>
      <div class="helix-search-pills">
        <a href="{{ routes.search_url }}?q=Running%20shoes">Running shoes</a>
        <a href="{{ routes.search_url }}?q=Trail%20running%20shoes">Trail running shoes</a>
        <a href="{{ routes.search_url }}?q=Hiking%20shoes">Hiking shoes</a>
      </div>
    </div>
  </aside>

  <aside class="helix-drawer" data-helix-drawer="cart" role="dialog" aria-modal="true" aria-labelledby="HelixCartTitle-{{ section.id }}" hidden>
    <div class="helix-drawer__top">
      <h2 id="HelixCartTitle-{{ section.id }}">{{ 'header.cart' | t }}</h2>
      <button class="helix-icon-button" type="button" data-helix-drawer-close aria-label="{{ 'general.close' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
      </button>
    </div>
    {% if cart.item_count == 0 %}
      <div class="helix-cart-empty">
        <p>{{ 'header.empty_cart' | t }}</p>
        <a href="{{ section.settings.trending_url }}">{{ 'header.trending' | t }}</a>
        <a href="{{ section.settings.best_sellers_url }}">{{ 'header.best_sellers' | t }}</a>
        <a href="{{ section.settings.sale_url }}">{{ 'header.on_sale' | t }}</a>
      </div>
    {% else %}
      <div class="helix-cart-summary">
        <p>{{ cart.item_count }} {{ 'header.items_in_cart' | t }}</p>
        <a class="helix-drawer-button" href="{{ routes.cart_url }}">{{ 'header.view_cart' | t }}</a>
        <a class="helix-drawer-button helix-drawer-button--dark" href="/checkout">{{ 'header.checkout' | t }}</a>
      </div>
    {% endif %}
  </aside>

  <nav class="helix-mobile-dock" aria-label="{{ 'header.mobile_quick_navigation' | t }}">
    <a href="{{ routes.root_url }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-7h6v7"/></svg>
      <span>{{ 'header.home' | t }}</span>
    </a>
    <button type="button" data-helix-mobile-open aria-label="{{ 'header.open_menu' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <span>{{ 'header.menu' | t }}</span>
    </button>
    <button type="button" data-helix-panel-open="search" aria-label="{{ 'header.search' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      <span>{{ 'header.search' | t }}</span>
    </button>
    <a href="{{ section.settings.find_shoes_url }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z"/><path d="m8 9 8 0M8 13h5"/></svg>
      <span>{{ 'header.shop' | t }}</span>
    </a>
    <button type="button" data-helix-panel-open="cart" aria-label="{{ 'header.cart' | t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20.5 7H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      <span>{{ 'header.cart' | t }}</span>
    </button>
    <a href="{{ routes.account_url }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg>
      <span>{{ 'header.account' | t }}</span>
    </a>
  </nav>
</div>

{% stylesheet %}
.helix-header-shell {
  position: relative;
  z-index: 70;
  height: 0;
  color: var(--helix-solid-text);
  font-family: var(--helix-font);
}

.helix-header-shell:not(.helix-header-shell--overlay) {
  height: 118px;
}

html.helix-lock-scroll,
body.helix-lock-scroll {
  overflow: hidden;
}

.helix-header-shell .helix-announcement {
  position: absolute;
  z-index: 4;
  top: 0;
  left: 0;
  display: grid;
  width: 100%;
  height: 38px;
  grid-template-columns: 1fr minmax(0, 720px) 1fr;
  align-items: center;
  padding-inline: 28px;
  background: var(--helix-announcement-bg);
  color: var(--helix-announcement-text);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .01em;
  line-height: 1;
  text-align: center;
}

.helix-header-shell .helix-announcement__messages {
  position: relative;
  display: grid;
  min-width: 0;
  height: 38px;
  place-items: center;
  overflow: hidden;
}

.helix-header-shell .helix-announcement__message {
  grid-area: 1 / 1;
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
}

.helix-header-shell .helix-announcement__message.is-active {
  animation: helix-announcement-in .6s cubic-bezier(.22, 1, .36, 1) both;
  opacity: 1;
  pointer-events: auto;
}

.helix-header-shell .helix-announcement__side {
  display: flex;
  align-items: center;
}

.helix-header-shell .helix-announcement__side--right {
  justify-content: flex-end;
}

.helix-header-shell .helix-announcement__side button {
  display: grid;
  width: 28px;
  height: 28px;
  padding: 0;
  place-items: center;
  border: 0;
  background: transparent;
  color: currentColor;
  cursor: pointer;
  opacity: .7;
  transition: opacity .2s ease, transform .2s ease;
}

.helix-header-shell .helix-announcement__side button:hover {
  opacity: 1;
  transform: translateX(2px);
}

.helix-header-shell .helix-announcement__side--left button:hover {
  transform: translateX(-2px);
}

.helix-header-shell .helix-announcement__side svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.6;
}

.helix-header-shell .helix-header {
  position: absolute;
  z-index: 3;
  top: 38px;
  left: 0;
  width: 100%;
  padding: 0 30px;
  color: var(--helix-overlay-text);
  transition: top .5s cubic-bezier(.6, 0, .4, 1), padding .5s cubic-bezier(.6, 0, .4, 1), transform .5s cubic-bezier(.6, 0, .4, 1);
}

.helix-header-shell .helix-header__surface {
  position: relative;
  display: grid;
  min-height: 80px;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 24px;
  padding: 16px 24px;
  border: 1px solid transparent;
  border-radius: 16px;
  background: transparent;
  transition: background .35s ease, border-color .35s ease, box-shadow .35s ease, border-radius .35s ease;
}

.helix-header-shell.is-scrolled .helix-header {
  position: fixed;
  top: 14px;
  padding-inline: clamp(18px, 3.472vw, 50px);
}

.helix-header-shell.is-scrolled .helix-header__surface {
  border-color: rgb(0 0 0 / 6%);
  background: #fff;
  box-shadow: 0 12px 36px rgb(0 0 0 / 8%);
  color: var(--helix-solid-text);
}

.helix-header-shell.is-scroll-hidden .helix-header {
  transform: translateY(calc(-100% - 30px));
}

.helix-header-shell .helix-nav {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: clamp(10px, 1.25vw, 24px);
}

.helix-header-shell .helix-nav--left {
  justify-content: flex-start;
}

.helix-header-shell .helix-nav-item {
  position: relative;
}

.helix-header-shell .helix-nav-trigger,
.helix-header-shell .helix-currency__trigger {
  position: relative;
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  gap: 7px;
  padding: 6px 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  white-space: nowrap;
}

.helix-header-shell .helix-nav-trigger::after {
  position: absolute;
  right: 0;
  bottom: 3px;
  left: 0;
  height: 1px;
  background: currentColor;
  content: "";
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .2s ease;
}

.helix-header-shell .helix-nav-trigger:hover::after,
.helix-header-shell .helix-nav-trigger:focus-visible::after {
  transform: scaleX(1);
}

.helix-header-shell .helix-nav-trigger svg,
.helix-header-shell .helix-currency__trigger svg {
  width: 12px;
  height: 12px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.7;
  transition: transform .5s cubic-bezier(.3, 1, .3, 1);
}

.helix-header-shell .helix-nav-item.is-open > .helix-nav-trigger svg,
.helix-header-shell .helix-nav-item.is-open > .helix-currency__trigger svg {
  transform: rotate(180deg);
}

.helix-header-shell .helix-brand {
  display: inline-flex;
  min-width: 140px;
  align-items: center;
  justify-content: center;
  color: inherit;
  text-align: center;
}

.helix-header-shell .helix-brand__logo {
  display: block;
  width: 145px;
  height: auto;
  max-height: 45px;
  object-fit: contain;
}

.helix-header-shell .helix-brand__logo--mobile,
.helix-header-shell .helix-brand__text--mobile {
  display: none;
}

.helix-header-shell .helix-brand__text {
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -.05em;
  line-height: 1;
  white-space: nowrap;
}

.helix-header-shell .helix-actions {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
}

.helix-header-shell .helix-currency {
  margin-right: 9px;
}

.helix-header-shell .helix-currency__trigger {
  gap: 6px;
  font-size: 13px;
}

.helix-header-shell .helix-currency__flag {
  display: inline-grid;
  width: 23px;
  height: 18px;
  place-items: center;
  border-radius: 3px;
  background: rgb(0 0 0 / 8%);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .02em;
}

.helix-header-shell .helix-action-button,
.helix-header-shell .helix-icon-button {
  position: relative;
  display: grid;
  width: 42px;
  height: 42px;
  padding: 0;
  place-items: center;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.helix-header-shell .helix-action-button svg,
.helix-header-shell .helix-icon-button svg {
  width: 21px;
  height: 21px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}

.helix-header-shell .helix-search-trigger {
  width: min(272px, 25vw);
  grid-template-columns: minmax(0, 1fr) 42px;
  text-align: left;
}

.helix-header-shell .helix-search-trigger__label {
  overflow: hidden;
  color: currentColor;
  font-size: 14px;
  font-weight: 500;
  opacity: .72;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.helix-header-shell .helix-cart-count {
  position: absolute;
  top: 1px;
  right: 0;
  display: grid;
  min-width: 17px;
  height: 17px;
  padding-inline: 4px;
  place-items: center;
  border-radius: 999px;
  background: currentColor;
  color: var(--helix-solid-text);
  font-size: 10px;
  line-height: 1;
}

.helix-header-shell .helix-mega-panel {
  position: fixed;
  z-index: 5;
  top: var(--helix-mega-top, 118px);
  right: 0;
  left: 0;
  overflow: hidden;
  background: #fff;
  color: var(--helix-solid-text);
  box-shadow: 0 18px 36px rgb(0 0 0 / 9%);
  opacity: 0;
  transform: translateY(-14px);
  transform-origin: top;
  transition: opacity .3s ease, transform .3s cubic-bezier(.3, 1, .3, 1);
}

.helix-header-shell .helix-mega-panel.is-open {
  opacity: 1;
  transform: translateY(0);
}

.helix-header-shell .helix-mega-panel__inner {
  width: min(1260px, calc(100% - 80px));
  margin-inline: auto;
  padding: 38px 0 42px;
}

.helix-header-shell .helix-mega-panel__columns {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(240px, 1.25fr);
  gap: 42px;
}

.helix-header-shell .helix-mega-panel__column {
  opacity: 0;
  transform: translateY(15px);
}

.helix-header-shell .helix-mega-panel.is-open .helix-mega-panel__column {
  animation: helix-menu-item-in .4s cubic-bezier(.22, 1, .36, 1) forwards;
}

.helix-header-shell .helix-mega-panel.is-open .helix-mega-panel__column:nth-child(2) {
  animation-delay: .08s;
}

.helix-header-shell .helix-mega-panel.is-open .helix-mega-panel__column:nth-child(3) {
  animation-delay: .16s;
}

.helix-header-shell .helix-mega-panel.is-open .helix-mega-panel__promos {
  animation: helix-menu-item-in .4s .24s cubic-bezier(.22, 1, .36, 1) forwards;
}

.helix-header-shell .helix-mega-panel__eyebrow,
.helix-header-shell .helix-drawer__eyebrow {
  margin: 0 0 16px;
  color: rgb(0 0 0 / 46%);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .13em;
  line-height: 1.2;
  text-transform: uppercase;
}

.helix-header-shell .helix-mega-panel__links {
  display: grid;
  gap: 8px;
}

.helix-header-shell .helix-mega-panel__links a {
  width: max-content;
  max-width: 100%;
  padding: 2px 0;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.45;
  transition: color .2s ease, transform .2s ease;
}

.helix-header-shell .helix-mega-panel__links a:hover {
  color: rgb(0 0 0 / 55%);
  transform: translateX(4px);
}

.helix-header-shell .helix-mega-panel__promos {
  min-height: 220px;
  opacity: 0;
  transform: translateY(15px);
}

.helix-header-shell .helix-mega-promo {
  position: relative;
  display: block;
  min-height: 220px;
  overflow: hidden;
  border-radius: 16px;
  background: #d9e2dc;
}

.helix-header-shell .helix-mega-promo img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 220px;
  object-fit: cover;
  transition: transform .6s cubic-bezier(.22, 1, .36, 1);
}

.helix-header-shell .helix-mega-promo:hover img {
  transform: scale(1.05);
}

.helix-header-shell .helix-mega-promo--fallback {
  display: flex;
  align-items: flex-end;
  padding: 24px;
  background: linear-gradient(145deg, #d7e3d7, #a9bca9);
}

.helix-header-shell .helix-mega-promo--fallback::before {
  position: absolute;
  right: 14%;
  bottom: -35%;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: rgb(255 255 255 / 32%);
  content: "";
}

.helix-header-shell .helix-mega-promo__content {
  position: absolute;
  right: 20px;
  bottom: 18px;
  left: 20px;
  display: grid;
  gap: 8px;
  color: #fff;
  text-shadow: 0 1px 8px rgb(0 0 0 / 25%);
}

.helix-header-shell .helix-mega-promo__content strong {
  font-size: 22px;
  line-height: 1.1;
}

.helix-header-shell .helix-mega-promo__content span {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.helix-header-shell .helix-simple-popover,
.helix-header-shell .helix-currency-popover {
  position: absolute;
  z-index: 6;
  top: calc(100% + 12px);
  right: 0;
  width: 270px;
  padding: 12px;
  border: 1px solid rgb(0 0 0 / 6%);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 14px 34px rgb(0 0 0 / 12%);
  color: var(--helix-solid-text);
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity .25s ease, transform .3s cubic-bezier(.3, 1, .3, 1);
}

.helix-header-shell .helix-simple-popover.is-open {
  opacity: 1;
  transform: translateY(0);
}

.helix-header-shell .helix-simple-popover > a {
  display: block;
  padding: 11px 12px;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 600;
  transition: background .2s ease, transform .2s ease;
}

.helix-header-shell .helix-simple-popover > a:hover {
  background: #f3f3f1;
  transform: translateX(3px);
}

.helix-header-shell .helix-currency-popover {
  right: -22px;
  width: 330px;
  padding: 20px;
}

.helix-header-shell .helix-popover__label {
  display: block;
  margin-bottom: 8px;
  color: rgb(0 0 0 / 58%);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.helix-header-shell .helix-country-search {
  width: 100%;
  height: 42px;
  padding: 0 12px;
  border: 1px solid rgb(0 0 0 / 12%);
  border-radius: 9px;
  outline: 0;
  background: #fff;
  color: var(--helix-solid-text);
  font-size: 13px;
}

.helix-header-shell .helix-country-search:focus {
  border-color: currentColor;
}

.helix-header-shell .helix-country-list {
  display: grid;
  max-height: 300px;
  margin-top: 12px;
  overflow: auto;
}

.helix-header-shell .helix-country-option {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  padding: 10px 6px;
  border: 0;
  border-bottom: 1px solid rgb(0 0 0 / 7%);
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
  font-size: 12px;
  text-align: left;
}

