{%- assign helix_header_id = 'helix-header-' | append: section.id -%}
{%- assign helix_header_font = section.settings.font_family -%}
{%- assign helix_header_font_bold = helix_header_font | font_modify: 'weight', '700' -%}
{%- assign helix_currency_code = localization.country.currency.iso_code | default: 'VND' -%}
{%- assign helix_currency_symbol = localization.country.currency.symbol | default: '₫' -%}
{%- assign helix_currency_form_id = 'HelixCurrencyForm-' | append: section.id -%}
{%- assign helix_mobile_currency_form_id = 'HelixMobileCurrencyForm-' | append: section.id -%}
{%- assign helix_mobile_language_form_id = 'HelixMobileLanguageForm-' | append: section.id -%}

{% style %}
  {% if helix_header_font != blank %}
    {{ helix_header_font | font_face: font_display: 'swap' }}
    {{ helix_header_font_bold | font_face: font_display: 'swap' }}
  {% endif %}
  .helix-header-shell {
    --helix-font: {% if helix_header_font != blank %}{{ helix_header_font.family }}, {{ helix_header_font.fallback_families }}{% else %}Arial, sans-serif{% endif %};
    --helix-overlay-text: {{ section.settings.overlay_text_color }};
    --helix-solid-text: {{ section.settings.solid_text_color }};
    --helix-announcement-bg: {{ section.settings.announcement_background }};
    --helix-announcement-text: {{ section.settings.announcement_text_color }};
  }
{% endstyle %}

<div
  id="{{ helix_header_id }}"
  class="helix-header-shell{% if section.settings.overlay_header %} helix-header-shell--overlay{% endif %}"
  data-helix-header
  data-sticky-enabled="{{ section.settings.sticky_header }}"
>
  {% if section.settings.show_announcement %}
    <div
      class="helix-announcement"
      data-helix-announcement
      data-interval="{{ section.settings.announcement_interval | times: 1000 }}"
    >
      <div class="helix-announcement__side helix-announcement__side--left">
        <button type="button" data-helix-announcement-prev aria-label="{{ 'header.previous_announcement' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg>
        </button>
      </div>
      <div class="helix-announcement__messages" aria-live="polite">
        <span class="helix-announcement__message is-active" data-helix-announcement-message>
          {{ section.settings.announcement_message_1 }}
        </span>
        <span class="helix-announcement__message" data-helix-announcement-message>
          {{ section.settings.announcement_message_2 }}
        </span>
      </div>
      <div class="helix-announcement__side helix-announcement__side--right">
        <button type="button" data-helix-announcement-next aria-label="{{ 'header.next_announcement' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  {% endif %}

  <header class="helix-header" aria-label="{{ 'header.primary_navigation' | t }}">
    <div class="helix-header__surface">
      <button
        class="helix-icon-button helix-mobile-menu-button"
        type="button"
        data-helix-mobile-open
        aria-controls="HelixMobileMenu-{{ section.id }}"
        aria-expanded="false"
        aria-label="{{ 'header.open_menu' | t }}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <nav class="helix-nav helix-nav--left" aria-label="{{ 'header.primary_navigation' | t }}">
        <div class="helix-nav-item helix-nav-item--mega" data-helix-mega-item>
          <a
            class="helix-nav-trigger"
            href="{{ section.settings.women_url }}"
            data-helix-mega-trigger
            aria-controls="HelixWomenMega-{{ section.id }}"
            aria-expanded="false"
          >
            <span>{{ section.settings.women_label }}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg>
          </a>
          <div id="HelixWomenMega-{{ section.id }}" class="helix-mega-panel" data-helix-mega-panel hidden>
            <div class="helix-mega-panel__inner">
              <div class="helix-mega-panel__columns">
                <div class="helix-mega-panel__column">
                  <p class="helix-mega-panel__eyebrow">{{ 'header.top_picks' | t }}</p>
                  <div class="helix-mega-panel__links">
                    {% if section.settings.women_top_menu != blank %}
                      {% for link in section.settings.women_top_menu.links %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section.settings.women_url }}">Best sellers</a>
                      <a href="{{ section.settings.women_url }}">Trending</a>
                      <a href="{{ section.settings.women_url }}">New arrivals</a>
                      <a href="{{ section.settings.women_url }}">On sale</a>
                    {% endif %}
                  </div>
                </div>
                <div class="helix-mega-panel__column">
                  <p class="helix-mega-panel__eyebrow">{{ 'header.by_activity' | t }}</p>
                  <div class="helix-mega-panel__links">
                    {% if section.settings.women_activity_menu != blank %}
                      {% for link in section.settings.women_activity_menu.links %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section.settings.women_url }}">Hiking</a>
                      <a href="{{ section.settings.women_url }}">Running</a>
                      <a href="{{ section.settings.women_url }}">Training</a>
                      <a href="{{ section.settings.women_url }}">Tennis</a>
                      <a href="{{ section.settings.women_url }}">Lifestyle</a>
                      <a href="{{ section.settings.women_url }}">Shop all</a>
                    {% endif %}
                  </div>
                </div>
                <div class="helix-mega-panel__column">
                  <p class="helix-mega-panel__eyebrow">{{ 'header.by_feature' | t }}</p>
                  <div class="helix-mega-panel__links">
                    {% if section.settings.women_feature_menu != blank %}
                      {% for link in section.settings.women_feature_menu.links %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section.settings.women_url }}">Cushioned</a>
                      <a href="{{ section.settings.women_url }}">Waterproof</a>
                      <a href="{{ section.settings.women_url }}">Water-resistant</a>
                      <a href="{{ section.settings.women_url }}">Breathable</a>
                      <a href="{{ section.settings.women_url }}">Windproof</a>
                    {% endif %}
                  </div>
                </div>
                <div class="helix-mega-panel__promos">
                  {% if section.settings.women_banner != blank %}
                    <a class="helix-mega-promo" href="{{ section.settings.women_banner_link | default: section.settings.women_url }}">
                      {{ section.settings.women_banner | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Women collection' }}
                      <span class="helix-mega-promo__content">
                        <strong>{{ section.settings.women_banner_title }}</strong>
                        <span>{{ 'header.shop_now' | t }} <span aria-hidden="true">↗</span></span>
                      </span>
                    </a>
                  {% else %}
                    <a class="helix-mega-promo helix-mega-promo--fallback" href="{{ section.settings.women_url }}">
                      <span class="helix-mega-promo__content">
                        <strong>{{ section.settings.women_banner_title }}</strong>
                        <span>{{ 'header.shop_now' | t }} <span aria-hidden="true">↗</span></span>
                      </span>
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="helix-nav-item helix-nav-item--mega" data-helix-mega-item>
          <a
            class="helix-nav-trigger"
            href="{{ section.settings.men_url }}"
            data-helix-mega-trigger
            aria-controls="HelixMenMega-{{ section.id }}"
            aria-expanded="false"
          >
            <span>{{ section.settings.men_label }}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg>
          </a>
          <div id="HelixMenMega-{{ section.id }}" class="helix-mega-panel" data-helix-mega-panel hidden>
            <div class="helix-mega-panel__inner">
              <div class="helix-mega-panel__columns">
                <div class="helix-mega-panel__column">
                  <p class="helix-mega-panel__eyebrow">{{ 'header.top_picks' | t }}</p>
                  <div class="helix-mega-panel__links">
                    {% if section.settings.men_top_menu != blank %}
                      {% for link in section.settings.men_top_menu.links %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section.settings.men_url }}">Best sellers</a>
                      <a href="{{ section.settings.men_url }}">Trending</a>
                      <a href="{{ section.settings.men_url }}">New arrivals</a>
                      <a href="{{ section.settings.men_url }}">On sale</a>
                    {% endif %}
                  </div>
                </div>
                <div class="helix-mega-panel__column">
                  <p class="helix-mega-panel__eyebrow">{{ 'header.by_activity' | t }}</p>
                  <div class="helix-mega-panel__links">
                    {% if section.settings.men_activity_menu != blank %}
                      {% for link in section.settings.men_activity_menu.links %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section.settings.men_url }}">Hiking</a>
                      <a href="{{ section.settings.men_url }}">Running</a>
                      <a href="{{ section.settings.men_url }}">Training</a>
                      <a href="{{ section.settings.men_url }}">Tennis</a>
                      <a href="{{ section.settings.men_url }}">Lifestyle</a>
                      <a href="{{ section.settings.men_url }}">Shop all</a>
                    {% endif %}
                  </div>
                </div>
                <div class="helix-mega-panel__column">
                  <p class="helix-mega-panel__eyebrow">{{ 'header.by_feature' | t }}</p>
                  <div class="helix-mega-panel__links">
                    {% if section.settings.men_feature_menu != blank %}
                      {% for link in section.settings.men_feature_menu.links %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    {% else %}
                      <a href="{{ section.settings.men_url }}">Cushioned</a>
                      <a href="{{ section.settings.men_url }}">Waterproof</a>
                      <a href="{{ section.settings.men_url }}">Water-resistant</a>
                      <a href="{{ section.settings.men_url }}">Breathable</a>
                      <a href="{{ section.settings.men_url }}">Windproof</a>
                    {% endif %}
                  </div>
                </div>
                <div class="helix-mega-panel__promos">
                  {% if section.settings.men_banner != blank %}
                    <a class="helix-mega-promo" href="{{ section.settings.men_banner_link | default: section.settings.men_url }}">
                      {{ section.settings.men_banner | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Men collection' }}
                      <span class="helix-mega-promo__content">
                        <strong>{{ section.settings.men_banner_title }}</strong>
                        <span>{{ 'header.shop_now' | t }} <span aria-hidden="true">↗</span></span>
                      </span>
                    </a>
                  {% else %}
                    <a class="helix-mega-promo helix-mega-promo--fallback" href="{{ section.settings.men_url }}">
                      <span class="helix-mega-promo__content">
                        <strong>{{ section.settings.men_banner_title }}</strong>
                        <span>{{ 'header.shop_now' | t }} <span aria-hidden="true">↗</span></span>
                      </span>
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="helix-nav-item helix-nav-item--popover" data-helix-popover>
          <button class="helix-nav-trigger" type="button" data-helix-popover-trigger aria-expanded="false" aria-controls="HelixPages-{{ section.id }}">
            <span>{{ section.settings.pages_label }}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg>
          </button>
          <div id="HelixPages-{{ section.id }}" class="helix-simple-popover" data-helix-popover-panel hidden>
            <a href="{{ section.settings.pages_about_url }}">About us</a>
            <a href="{{ section.settings.pages_contact_url }}">Contact</a>
            <a href="{{ section.settings.pages_faq_url }}">Faqs</a>
            <a href="{{ section.settings.pages_store_url }}">Store locations</a>
            <a href="{{ section.settings.pages_recent_url }}">Recently viewed</a>
            <a href="{{ section.settings.pages_journal_url }}">Our journal</a>
          </div>
        </div>

        <a class="helix-nav-trigger helix-nav-trigger--plain" href="{{ section.settings.find_shoes_url }}">{{ section.settings.find_shoes_label }}</a>
      </nav>

      <a class="helix-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 650 | image_tag: class: 'helix-brand__logo helix-brand__logo--desktop', loading: 'eager', alt: shop.name }}
        {% else %}
          <span class="helix-brand__text">{{ section.settings.logo_text | default: shop.name }}</span>
        {% endif %}
        {% if section.settings.mobile_logo != blank %}
          {{ section.settings.mobile_logo | image_url: width: 500 | image_tag: class: 'helix-brand__logo helix-brand__logo--mobile', loading: 'eager', alt: shop.name }}
        {% elsif section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 500 | image_tag: class: 'helix-brand__logo helix-brand__logo--mobile', loading: 'eager', alt: shop.name }}
        {% else %}
          <span class="helix-brand__text helix-brand__text--mobile">{{ section.settings.logo_text | default: shop.name }}</span>
        {% endif %}
      </a>

      <div class="helix-actions">
        <div class="helix-currency helix-nav-item helix-nav-item--popover" data-helix-popover>
          <button class="helix-currency__trigger" type="button" data-helix-popover-trigger aria-expanded="false" aria-controls="HelixCurrency-{{ section.id }}">
            <span class="helix-currency__flag" aria-hidden="true">{{ localization.country.iso_code | default: 'VN' }}</span>
            <span>{{ helix_currency_code }} {{ helix_currency_symbol }}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg>
          </button>
          <div id="HelixCurrency-{{ section.id }}" class="helix-currency-popover helix-simple-popover" data-helix-popover-panel hidden>
            {% form 'localization', id: helix_currency_form_id %}
              <label class="helix-popover__label" for="HelixCountrySearch-{{ section.id }}">{{ 'header.search_country' | t }}</label>
              <input id="HelixCountrySearch-{{ section.id }}" class="helix-country-search" type="search" placeholder="{{ 'header.search_country' | t }}" data-helix-country-filter>
              <div class="helix-country-list" role="listbox">
                {% if localization.available_countries != blank %}
                  {% for country in localization.available_countries limit: 10 %}
                    <button class="helix-country-option" type="submit" name="country_code" value="{{ country.iso_code }}" data-helix-country-option>
                      <span>{{ country.iso_code }}</span>
                      <span>{{ country.name }}</span>
                      <span>{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                    </button>
                  {% endfor %}
                {% endif %}
              </div>
            {% endform %}
          </div>
        </div>

        <button class="helix-action-button helix-search-trigger" type="button" data-helix-panel-open="search" aria-label="{{ 'header.search' | t }}">
          <span class="helix-search-trigger__label">{{ section.settings.search_placeholder }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
        </button>
        <a class="helix-action-button helix-account-button" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg>
        </a>
        <button class="helix-action-button helix-cart-button" type="button" data-helix-panel-open="cart" aria-label="{{ 'header.cart' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20.5 7H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
          {% if cart.item_count > 0 %}<span class="helix-cart-count">{{ cart.item_count }}</span>{% endif %}
        </button>
      </div>
    </div>
  </header>

  <button class="helix-overlay" type="button" data-helix-overlay-close aria-label="{{ 'general.close' | t }}" hidden></button>
  <button class="helix-mega-scrim" type="button" data-helix-mega-close aria-label="{{ 'general.close' | t }}" hidden></button>

  <div id="HelixMobileMenu-{{ section.id }}" class="helix-mobile-menu" data-helix-mobile-menu hidden>
    <aside class="helix-mobile-menu__panel" aria-label="{{ 'general.menu' | t }}">
      <div class="helix-mobile-view is-active" data-helix-mobile-view="top">
        <div class="helix-mobile-view__top">
          <span class="helix-mobile-view__title">{{ 'general.menu' | t }}</span>
          <button class="helix-icon-button" type="button" data-helix-mobile-close aria-label="{{ 'general.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
          </button>
        </div>
        <nav class="helix-mobile-links">
          <button type="button" data-helix-mobile-view-open="women"><span>{{ section.settings.women_label }}</span><span aria-hidden="true">→</span></button>
          <button type="button" data-helix-mobile-view-open="men"><span>{{ section.settings.men_label }}</span><span aria-hidden="true">→</span></button>
          <button type="button" data-helix-mobile-view-open="pages"><span>{{ section.settings.pages_label }}</span><span aria-hidden="true">→</span></button>
          <a href="{{ section.settings.find_shoes_url }}"><span>{{ section.settings.find_shoes_label }}</span><span aria-hidden="true">↗</span></a>
          <a href="{{ routes.account_url }}"><span>{{ 'header.login' | t }}</span><span aria-hidden="true">↗</span></a>
          <button type="button" data-helix-mobile-view-open="currency"><span>{{ helix_currency_code }} {{ helix_currency_symbol }}</span><span aria-hidden="true">→</span></button>
          <button type="button" data-helix-mobile-view-open="language"><span>{{ localization.language.endonym_name | default: 'English' }}</span><span aria-hidden="true">→</span></button>
        </nav>
      </div>

      <div class="helix-mobile-view" data-helix-mobile-view="women" hidden>
        <div class="helix-mobile-view__top">
          <button class="helix-mobile-back" type="button" data-helix-mobile-view-open="top" aria-label="{{ 'general.back' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg>
            <span>{{ section.settings.women_label }}</span>
          </button>
          <button class="helix-icon-button" type="button" data-helix-mobile-close aria-label="{{ 'general.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
          </button>
        </div>
        <div class="helix-mobile-accordions">
          <details open>
            <summary>{{ 'header.top_picks' | t }}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg></summary>
            <div>
              <a href="{{ section.settings.women_url }}">Best sellers</a>
              <a href="{{ section.settings.women_url }}">Trending</a>
              <a href="{{ section.settings.women_url }}">New arrivals</a>
              <a href="{{ section.settings.women_url }}">On sale</a>
            </div>
          </details>
          <details>
            <summary>{{ 'header.by_activity' | t }}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg></summary>
            <div>
              <a href="{{ section.settings.women_url }}">Hiking</a>
              <a href="{{ section.settings.women_url }}">Running</a>
              <a href="{{ section.settings.women_url }}">Training</a>
              <a href="{{ section.settings.women_url }}">Tennis</a>
              <a href="{{ section.settings.women_url }}">Lifestyle</a>
              <a href="{{ section.settings.women_url }}">Shop all</a>
            </div>
          </details>
          <details>
            <summary>{{ 'header.by_feature' | t }}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg></summary>
            <div>
              <a href="{{ section.settings.women_url }}">Cushioned</a>
              <a href="{{ section.settings.women_url }}">Waterproof</a>
              <a href="{{ section.settings.women_url }}">Water-resistant</a>
              <a href="{{ section.settings.women_url }}">Breathable</a>
              <a href="{{ section.settings.women_url }}">Windproof</a>
            </div>
          </details>
        </div>
      </div>

      <div class="helix-mobile-view" data-helix-mobile-view="men" hidden>
        <div class="helix-mobile-view__top">
          <button class="helix-mobile-back" type="button" data-helix-mobile-view-open="top" aria-label="{{ 'general.back' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"/></svg>
            <span>{{ section.settings.men_label }}</span>
          </button>
          <button class="helix-icon-button" type="button" data-helix-mobile-close aria-label="{{ 'general.close' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
          </button>
        </div>
        <div class="helix-mobile-accordions">
          <details open>
            <summary>{{ 'header.top_picks' | t }}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg></summary>
            <div>
