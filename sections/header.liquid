{% javascript %}
(function () {
  function initHelixHeader(root) {
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    var html = document.documentElement;
    var header = root.querySelector('.helix-header');
    var overlay = root.querySelector('[data-helix-overlay-close]');
    var megaScrim = root.querySelector('[data-helix-mega-close]');
    var mobileMenu = root.querySelector('[data-helix-mobile-menu]');
    var mobileOpenButtons = root.querySelectorAll('[data-helix-mobile-open]');
    var mobileCloseButtons = root.querySelectorAll('[data-helix-mobile-close]');
    var drawerNodes = root.querySelectorAll('[data-helix-drawer]');
    var megaItems = root.querySelectorAll('[data-helix-mega-item]');
    var popovers = root.querySelectorAll('[data-helix-popover]');
    var mobileViews = root.querySelectorAll('[data-helix-mobile-view]');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var closeTimer;
    var announcementTimer;
    var lastScrollY = window.scrollY;
    var scrollTicking = false;

    function lockScroll(locked) {
      html.classList.toggle('helix-lock-scroll', locked);
      if (document.body) document.body.classList.toggle('helix-lock-scroll', locked);
    }

    function setOpenState(element, open) {
      if (!element) return;
      if (open) {
        element.hidden = false;
        window.requestAnimationFrame(function () {
          element.classList.add('is-open');
        });
      } else {
        element.classList.remove('is-open');
        window.setTimeout(function () {
          if (!element.classList.contains('is-open')) element.hidden = true;
        }, 520);
      }
    }

    function closePopovers() {
      popovers.forEach(function (popover) {
        popover.classList.remove('is-open');
        var panel = popover.querySelector('[data-helix-popover-panel]');
        var trigger = popover.querySelector('[data-helix-popover-trigger]');
        if (panel) panel.hidden = true;
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    }

    function closeMega() {
      window.clearTimeout(closeTimer);
      megaItems.forEach(function (item) {
        item.classList.remove('is-open');
        var panel = item.querySelector('[data-helix-mega-panel]');
        var trigger = item.querySelector('[data-helix-mega-trigger]');
        if (panel) {
          panel.classList.remove('is-open');
          panel.hidden = true;
        }
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
      if (megaScrim) {
        megaScrim.classList.remove('is-open');
        megaScrim.hidden = true;
      }
      root.classList.remove('is-mega-open');
      if (!mobileMenu || mobileMenu.hidden) lockScroll(false);
    }

    function openMega(item) {
      if (window.matchMedia('(max-width: 989px)').matches) return;
      window.clearTimeout(closeTimer);
      closePopovers();
      closeDrawers();
      megaItems.forEach(function (other) {
        if (other !== item) {
          other.classList.remove('is-open');
          var otherPanel = other.querySelector('[data-helix-mega-panel]');
          var otherTrigger = other.querySelector('[data-helix-mega-trigger]');
          if (otherPanel) {
            otherPanel.classList.remove('is-open');
            otherPanel.hidden = true;
          }
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
        }
      });
      var panel = item.querySelector('[data-helix-mega-panel]');
      var trigger = item.querySelector('[data-helix-mega-trigger]');
      if (!panel || !trigger) return;
      var rect = header.getBoundingClientRect();
      root.style.setProperty('--helix-mega-top', Math.round(rect.bottom + 1) + 'px');
      item.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      window.requestAnimationFrame(function () {
        panel.classList.add('is-open');
        if (megaScrim) {
          megaScrim.hidden = false;
          window.requestAnimationFrame(function () {
            megaScrim.classList.add('is-open');
          });
        }
      });
      root.classList.add('is-mega-open');
      lockScroll(true);
    }

    function scheduleMegaClose() {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(closeMega, 140);
    }

    function openPopover(popover) {
      closeMega();
      closeDrawers();
      closePopovers();
      var panel = popover.querySelector('[data-helix-popover-panel]');
      var trigger = popover.querySelector('[data-helix-popover-trigger]');
      if (!panel || !trigger) return;
      popover.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      window.requestAnimationFrame(function () {
        panel.classList.add('is-open');
      });
    }

    function closeDrawers() {
      drawerNodes.forEach(function (drawer) {
        drawer.classList.remove('is-open');
        drawer.hidden = true;
      });
      if (overlay) {
        overlay.classList.remove('is-open');
        overlay.hidden = true;
      }
      root.classList.remove('is-drawer-open');
      if (!mobileMenu || mobileMenu.hidden) lockScroll(false);
    }

    function openDrawer(name) {
      closeMega();
      closePopovers();
      if (mobileMenu && !mobileMenu.hidden) closeMobileMenu();
      closeDrawers();
      var drawer = root.querySelector('[data-helix-drawer="' + name + '"]');
      if (!drawer) return;
      drawer.hidden = false;
      if (overlay) {
        overlay.hidden = false;
        window.requestAnimationFrame(function () {
          overlay.classList.add('is-open');
        });
      }
      window.requestAnimationFrame(function () {
        drawer.classList.add('is-open');
      });
      root.classList.add('is-drawer-open');
      lockScroll(true);
      var firstInput = drawer.querySelector('input');
      if (firstInput) window.setTimeout(function () { firstInput.focus(); }, 120);
    }

    function setMobileView(name) {
      mobileViews.forEach(function (view) {
        var active = view.getAttribute('data-helix-mobile-view') === name;
        view.hidden = !active;
        view.classList.toggle('is-active', active);
      });
    }

    function openMobileMenu() {
      closeMega();
      closePopovers();
      closeDrawers();
      setMobileView('top');
      if (!mobileMenu) return;
      mobileMenu.hidden = false;
      if (overlay) {
        overlay.hidden = false;
        window.requestAnimationFrame(function () {
          overlay.classList.add('is-open');
        });
      }
      window.requestAnimationFrame(function () {
        mobileMenu.classList.add('is-open');
      });
      mobileOpenButtons.forEach(function (button) { button.setAttribute('aria-expanded', 'true'); });
      lockScroll(true);
    }

    function closeMobileMenu() {
      if (!mobileMenu) return;
      mobileMenu.classList.remove('is-open');
      if (overlay) overlay.classList.remove('is-open');
      window.setTimeout(function () {
        if (!mobileMenu.classList.contains('is-open')) mobileMenu.hidden = true;
        if (overlay && !root.classList.contains('is-drawer-open')) overlay.hidden = true;
      }, 520);
      mobileOpenButtons.forEach(function (button) { button.setAttribute('aria-expanded', 'false'); });
      if (!root.classList.contains('is-drawer-open')) lockScroll(false);
    }

    function updateScrollState() {
      var scrollY = window.scrollY;
      var stickyEnabled = root.getAttribute('data-sticky-enabled') !== 'false';
      if (stickyEnabled) root.classList.toggle('is-scrolled', scrollY > 24);
      if (window.matchMedia('(max-width: 989px)').matches) {
        if (scrollY <= 24) {
          root.classList.remove('is-scroll-hidden');
        } else if (scrollY > lastScrollY + 4) {
          root.classList.add('is-scroll-hidden');
        } else if (scrollY < lastScrollY - 4) {
          root.classList.remove('is-scroll-hidden');
        }
      } else {
        root.classList.remove('is-scroll-hidden');
      }
      lastScrollY = scrollY;
      scrollTicking = false;
    }

    function requestScrollUpdate() {
      if (scrollTicking) return;
      scrollTicking = true;
      window.requestAnimationFrame(updateScrollState);
    }

    function showAnnouncement(index) {
      var announcement = root.querySelector('[data-helix-announcement]');
      if (!announcement) return;
      var messages = announcement.querySelectorAll('[data-helix-announcement-message]');
      if (!messages.length) return;
      var nextIndex = (index + messages.length) % messages.length;
      messages.forEach(function (message, messageIndex) {
        message.classList.toggle('is-active', messageIndex === nextIndex);
      });
      announcement.dataset.index = String(nextIndex);
    }

    function restartAnnouncementTimer() {
      window.clearInterval(announcementTimer);
      var announcement = root.querySelector('[data-helix-announcement]');
      if (!announcement || reducedMotion) return;
      var interval = parseInt(announcement.getAttribute('data-interval'), 10);
      if (!interval || interval < 1000) interval = 5000;
      announcementTimer = window.setInterval(function () {
        var current = parseInt(announcement.dataset.index || '0', 10);
        showAnnouncement(current + 1);
      }, interval);
    }

    root.querySelector('[data-helix-announcement-prev]')?.addEventListener('click', function () {
      var announcement = root.querySelector('[data-helix-announcement]');
      var current = parseInt((announcement && announcement.dataset.index) || '0', 10);
      showAnnouncement(current - 1);
      restartAnnouncementTimer();
    });

    root.querySelector('[data-helix-announcement-next]')?.addEventListener('click', function () {
      var announcement = root.querySelector('[data-helix-announcement]');
      var current = parseInt((announcement && announcement.dataset.index) || '0', 10);
      showAnnouncement(current + 1);
      restartAnnouncementTimer();
    });

    root.querySelector('[data-helix-announcement]')?.addEventListener('mouseenter', function () {
      window.clearInterval(announcementTimer);
    });

    root.querySelector('[data-helix-announcement]')?.addEventListener('mouseleave', restartAnnouncementTimer);

    megaItems.forEach(function (item) {
      item.addEventListener('mouseenter', function () { openMega(item); });
      item.addEventListener('mouseleave', scheduleMegaClose);
      item.querySelector('[data-helix-mega-trigger]')?.addEventListener('focus', function () { openMega(item); });
      item.querySelector('[data-helix-mega-panel]')?.addEventListener('mouseenter', function () { window.clearTimeout(closeTimer); });
      item.querySelector('[data-helix-mega-panel]')?.addEventListener('mouseleave', scheduleMegaClose);
    });

    popovers.forEach(function (popover) {
      var trigger = popover.querySelector('[data-helix-popover-trigger]');
      var panel = popover.querySelector('[data-helix-popover-panel]');
      trigger?.addEventListener('mouseenter', function () { openPopover(popover); });
      trigger?.addEventListener('focus', function () { openPopover(popover); });
      trigger?.addEventListener('click', function () {
        if (popover.classList.contains('is-open')) closePopovers();
        else openPopover(popover);
      });
      popover.addEventListener('mouseleave', function () {
        window.setTimeout(function () {
          if (!popover.matches(':hover')) {
            popover.classList.remove('is-open');
            if (panel) panel.hidden = true;
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
          }
        }, 120);
      });
    });

    root.querySelectorAll('[data-helix-panel-open]').forEach(function (button) {
      button.addEventListener('click', function () {
        openDrawer(button.getAttribute('data-helix-panel-open'));
      });
    });

    root.querySelectorAll('[data-helix-drawer-close]').forEach(function (button) {
      button.addEventListener('click', closeDrawers);
    });

    overlay?.addEventListener('click', function () {
      closeDrawers();
      closeMobileMenu();
    });

    megaScrim?.addEventListener('click', function () {
      closeMega();
      lockScroll(false);
    });

    mobileOpenButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        if (mobileMenu && mobileMenu.hidden) openMobileMenu();
        else closeMobileMenu();
      });
    });

    mobileCloseButtons.forEach(function (button) {
      button.addEventListener('click', closeMobileMenu);
    });

    root.querySelectorAll('[data-helix-mobile-view-open]').forEach(function (button) {
      button.addEventListener('click', function () {
        setMobileView(button.getAttribute('data-helix-mobile-view-open'));
      });
    });

    root.querySelectorAll('[data-helix-country-filter]').forEach(function (input) {
      input.addEventListener('input', function () {
        var query = input.value.toLowerCase().trim();
        root.querySelectorAll('[data-helix-country-option]').forEach(function (option) {
          option.hidden = query && !option.textContent.toLowerCase().includes(query);
        });
      });
    });

    document.addEventListener('click', function (event) {
      if (!root.contains(event.target)) {
        closeMega();
        closePopovers();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      closeMega();
      closePopovers();
      closeDrawers();
      closeMobileMenu();
      lockScroll(false);
    });

    window.addEventListener('scroll', requestScrollUpdate, { passive: true });
    window.addEventListener('resize', function () {
      if (window.matchMedia('(min-width: 990px)').matches && mobileMenu && !mobileMenu.hidden) closeMobileMenu();
      if (root.classList.contains('is-mega-open')) {
        var rect = header.getBoundingClientRect();
        root.style.setProperty('--helix-mega-top', Math.round(rect.bottom + 1) + 'px');
      }
    });

    updateScrollState();
    restartAnnouncementTimer();
  }

  function bootHelixHeaders() {
    document.querySelectorAll('[data-helix-header]').forEach(initHelixHeader);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootHelixHeaders);
  else bootHelixHeaders();
  document.addEventListener('shopify:section:load', bootHelixHeaders);
})();
{% endjavascript %}

