{%- assign categories_id = 'pebble-categories-' | append: section.id -%}
{%- assign categories_font = section.settings.font_family -%}
{%- assign categories_font_bold = categories_font | font_modify: 'weight', '700' -%}

{% style %}
  {{ categories_font | font_face: font_display: 'swap' }}
  {{ categories_font_bold | font_face: font_display: 'swap' }}
  #{{ categories_id }} { --pebble-categories-font: {{ categories_font.family }}, {{ categories_font.fallback_families }}; }
{% endstyle %}

<section id="{{ categories_id }}" class="pebble-categories" data-pebble-categories>
  <div class="pebble-categories__inner">
    <div class="pebble-categories__header">
      <h2 class="pebble-categories__heading" data-pebble-reveal>{{ section.settings.heading }}</h2>
      <div class="pebble-categories__tabs" role="tablist" aria-label="{{ section.settings.heading }}">
        <button id="{{ categories_id }}-tab-boys" class="pebble-categories__tab is-active" type="button" role="tab" aria-selected="true" aria-controls="{{ categories_id }}-panel-boys" data-category-tab="boys">{{ section.settings.boys_label }}</button>
        <button id="{{ categories_id }}-tab-girls" class="pebble-categories__tab" type="button" role="tab" aria-selected="false" aria-controls="{{ categories_id }}-panel-girls" data-category-tab="girls">{{ section.settings.girls_label }}</button>
      </div>
    </div>

    {% for audience in (1..2) %}
      {%- if audience == 1 -%}{%- assign audience_key = 'boys' -%}{%- else -%}{%- assign audience_key = 'girls' -%}{%- endif -%}
      <div id="{{ categories_id }}-panel-{{ audience_key }}" class="pebble-categories__panel{% if audience_key == 'boys' %} is-active{% endif %}" role="tabpanel" aria-labelledby="{{ categories_id }}-tab-{{ audience_key }}" data-category-panel="{{ audience_key }}"{% unless audience_key == 'boys' %} hidden{% endunless %}>
        <div class="pebble-categories__viewport" data-category-viewport>
          <div class="pebble-categories__track" data-category-track>
            {% for block in section.blocks %}
              {% if block.settings.audience == audience_key %}
                {%- assign card_url = block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url -%}
                {%- assign card_title = block.settings.title | default: block.settings.collection.title -%}
                <article class="pebble-category-card" data-category-card {{ block.shopify_attributes }}>
                  <a class="pebble-category-card__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}"></a>
                  <div class="pebble-category-card__media" data-pebble-reveal>
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'pebble-category-card__image', loading: 'lazy', sizes: '(min-width: 1024px) 20vw, (min-width: 768px) 25vw, 42vw', alt: card_title }}
                    {% elsif block.settings.image_url != blank %}
                      <img class="pebble-category-card__image" src="{{ block.settings.image_url | escape }}" alt="{{ card_title | escape }}" width="720" height="936" loading="lazy">
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'pebble-category-card__image pebble-category-card__placeholder' }}
                    {% endif %}
                  </div>
                  <h3 class="pebble-category-card__title"><span>{{ card_title }}</span>{% if block.settings.count != blank %}<sup>{{ block.settings.count }}</sup>{% endif %}</h3>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="pebble-categories__controls" data-category-controls>
          <div class="pebble-categories__progress" aria-hidden="true"><span data-category-progress></span></div>
          <button type="button" data-category-prev aria-label="{{ 'general.previous' | t }}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 16.25 6.25 10l6.25-6.25"/></svg></button>
          <button type="button" data-category-next aria-label="{{ 'general.next' | t }}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 3.75 6.25 6.25-6.25 6.25"/></svg></button>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.section-pebble-categories { position: relative; z-index: 3; }
.pebble-categories { position: relative; width: 100%; margin-top: -34px; overflow: hidden; border-radius: 20px 20px 0 0; background: #fff; color: #0a0a0a; font-family: var(--pebble-categories-font, Arial, sans-serif); }
.pebble-categories__inner { width: 100%; padding: clamp(48px, 5.508vw, 80px) clamp(16px, 3.472vw, 50px) 0; }
.pebble-categories__header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 40px; }
.pebble-categories__heading { margin: 0; font-family: inherit; font-size: clamp(28px, 2.778vw, 40px); font-weight: 700; line-height: 1.2; letter-spacing: 0; }
.pebble-categories__tabs { display: flex; align-items: center; gap: 8px; }
.pebble-categories__tab { position: relative; z-index: 0; display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 6px 12px; overflow: hidden; border: 0; border-radius: 999px; background: transparent; color: #0a0a0a; font-family: inherit; font-size: 15px; font-weight: 500; line-height: 24px; cursor: pointer; }
.pebble-categories__tab::before { position: absolute; z-index: -1; inset: 0; width: 0; border-radius: inherit; background: #ebebeb; content: ''; transition: width .3s; }
.pebble-categories__tab.is-active::before { width: 100%; }
.pebble-categories__panel { opacity: 0; transition: opacity .3s ease; }
.pebble-categories__panel.is-active { opacity: 1; }
.pebble-categories__viewport { width: 100%; overflow: hidden; }
.pebble-categories__track { display: flex; gap: 10px; transform: translate3d(0,0,0); transition: transform .65s cubic-bezier(.16,1,.3,1); touch-action: pan-y; cursor: grab; }
.pebble-categories__track.is-dragging { transition: none; cursor: grabbing; user-select: none; }
.pebble-category-card { position: relative; flex: 0 0 calc((100% - 40px) / 5); min-width: 0; }
.pebble-category-card__link { position: absolute; z-index: 3; inset: 0; }
.pebble-category-card__media { position: relative; width: 100%; aspect-ratio: 10 / 13; overflow: hidden; border-radius: 20px; background: #eee; }
.pebble-category-card__image { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1); transition: transform .5s cubic-bezier(.3,1,.3,1), opacity .3s ease; }
.pebble-category-card__title { display: flex; align-items: flex-start; gap: 8px; margin: 12px 0 0; font-family: inherit; font-size: 16px; font-weight: 700; line-height: 26px; }
.pebble-category-card__title sup { position: static; color: #555; font-size: 15px; font-weight: 500; line-height: 20px; }
.pebble-categories__controls { display: flex; align-items: center; justify-content: flex-end; gap: 8px; min-height: 76px; }
.pebble-categories__controls button { display: grid; width: 44px; height: 44px; padding: 0; place-items: center; border: 1px solid #1a1a1a; border-radius: 50%; background: transparent; color: #0a0a0a; cursor: pointer; transition: opacity .2s ease, background .2s ease, color .2s ease; }
.pebble-categories__controls button:hover { background: #0a0a0a; color: #fff; }
.pebble-categories__controls button:disabled { opacity: .5; pointer-events: none; }
.pebble-categories__controls svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.pebble-categories__progress { position: relative; width: 140px; height: 2px; margin-right: 8px; overflow: hidden; background: #e5e5e5; }
.pebble-categories__progress span { position: absolute; inset: 0; background: #111; transform: scaleX(.5); transform-origin: left; transition: transform .65s cubic-bezier(.16,1,.3,1); }
[data-pebble-reveal] { opacity: 0; transform: translateY(25px); transition: opacity 1.5s cubic-bezier(.16,1,.3,1), transform 1.5s cubic-bezier(.16,1,.3,1); }
.pebble-category-card__media[data-pebble-reveal] .pebble-category-card__image { transform: scale(1.15); transition: transform 1.3s cubic-bezier(.16,1,.3,1), opacity .3s ease; }
[data-pebble-reveal].is-in-view { opacity: 1; transform: translateY(0); }
.pebble-category-card__media[data-pebble-reveal].is-in-view .pebble-category-card__image { transform: scale(1); }
@media (hover: hover) and (pointer: fine) { .pebble-category-card:hover .pebble-category-card__media.is-in-view .pebble-category-card__image { transform: scale(1.05); } }

@media (min-width: 768px) and (max-width: 1023px) {
  .pebble-category-card { flex-basis: calc((100% - 30px) / 4); }
  .pebble-categories__controls { display: none; }
}

@media (max-width: 767px) {
  .pebble-categories { margin-top: -18px; }
  .pebble-categories__inner { padding: 48px 16px 0; }
  .pebble-categories__header { flex-direction: column; align-items: flex-start; margin-bottom: 24px; }
  .pebble-categories__heading { font-size: 28px; line-height: 33.6px; }
  .pebble-categories__viewport { width: calc(100% + 16px); overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
  .pebble-categories__viewport::-webkit-scrollbar { display: none; }
  .pebble-categories__track { width: max-content; gap: 8px; transform: none !important; touch-action: pan-x; }
  .pebble-category-card { flex-basis: auto; width: calc((100vw - 32px) * .414); scroll-snap-align: start; }
  .pebble-categories__controls { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .pebble-categories__panel, .pebble-categories__track, [data-pebble-reveal], .pebble-category-card__image { transition: none !important; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function initCategories(root) {
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-category-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-category-panel]'));
    var activeKey = 'boys';

    function setupPanel(panel) {
      var viewport = panel.querySelector('[data-category-viewport]');
      var track = panel.querySelector('[data-category-track]');
      var cards = Array.prototype.slice.call(panel.querySelectorAll('[data-category-card]'));
      var previous = panel.querySelector('[data-category-prev]');
      var next = panel.querySelector('[data-category-next]');
      var progress = panel.querySelector('[data-category-progress]');
      var index = 0;
      var startX = 0;
      var lastX = 0;
      var pointerId = null;
      function visibleCount() { return window.innerWidth < 768 ? 2 : (window.innerWidth < 1024 ? 4 : 5); }
      function maxIndex() { return Math.max(0, cards.length - visibleCount()); }
      function gap() { return 10; }
      function update(animate) {
        index = Math.max(0, Math.min(index, maxIndex()));
        if (window.innerWidth >= 768 && cards[0]) {
          track.style.transition = animate === false ? 'none' : '';
          track.style.transform = 'translate3d(' + (-(cards[0].getBoundingClientRect().width + gap()) * index) + 'px,0,0)';
        } else {
          track.style.transform = '';
        }
        if (previous) previous.disabled = index === 0;
        if (next) next.disabled = index === maxIndex();
        if (progress) progress.style.transform = 'scaleX(' + Math.min(1, (index + visibleCount()) / Math.max(cards.length, 1)) + ')';
      }
      previous?.addEventListener('click', function () { index -= 1; update(); });
      next?.addEventListener('click', function () { index += 1; update(); });
      track?.addEventListener('pointerdown', function (event) {
        if (window.innerWidth < 768 || event.target.closest('a,button') || event.button !== 0) return;
        pointerId = event.pointerId; startX = lastX = event.clientX; track.setPointerCapture?.(pointerId); track.classList.add('is-dragging');
      });
      track?.addEventListener('pointermove', function (event) {
        if (event.pointerId !== pointerId || !cards[0]) return;
        lastX = event.clientX;
        var base = -(cards[0].getBoundingClientRect().width + gap()) * index;
        track.style.transform = 'translate3d(' + (base + lastX - startX) + 'px,0,0)';
      });
      function finish(event) {
        if (event.pointerId !== pointerId) return;
        var distance = lastX - startX;
        if (Math.abs(distance) > 40) index += distance < 0 ? 1 : -1;
        track.classList.remove('is-dragging'); pointerId = null; update();
      }
      track?.addEventListener('pointerup', finish);
      track?.addEventListener('pointercancel', finish);
      window.addEventListener('resize', function () { update(false); });
      update(false);
    }
    panels.forEach(setupPanel);

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var key = tab.dataset.categoryTab;
        if (key === activeKey) return;
        var previousPanel = panels.find(function (panel) { return panel.dataset.categoryPanel === activeKey; });
        var nextPanel = panels.find(function (panel) { return panel.dataset.categoryPanel === key; });
        tabs.forEach(function (item) { var active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); });
        if (!nextPanel) return;
        if (previousPanel) {
          previousPanel.classList.remove('is-active');
          previousPanel.hidden = true;
        }
        nextPanel.hidden = false;
        window.requestAnimationFrame(function () {
          nextPanel.classList.add('is-active');
        });
        activeKey = key;
      });
    });

    var revealItems = root.querySelectorAll('[data-pebble-reveal]');
    if (!('IntersectionObserver' in window)) revealItems.forEach(function (item) { item.classList.add('is-in-view'); });
    else {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-in-view'); observer.unobserve(entry.target); } });
      }, { threshold: .12, rootMargin: '0px 0px -4% 0px' });
      revealItems.forEach(function (item, index) { item.style.transitionDelay = Math.min(index * 50, 250) + 'ms'; observer.observe(item); });
    }
  }
  function boot() { document.querySelectorAll('[data-pebble-categories]').forEach(initCategories); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', boot);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Pebble categories",
  "tag": "section",
  "class": "section-pebble-categories",
  "max_blocks": 20,
  "settings": [
    { "type": "font_picker", "id": "font_family", "label": "Typography", "default": "bricolage_grotesque_n5" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Categories" },
    { "type": "text", "id": "boys_label", "label": "First tab label", "default": "Boy’s" },
    { "type": "text", "id": "girls_label", "label": "Second tab label", "default": "Girl’s" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "select", "id": "audience", "label": "Tab", "options": [{ "value": "boys", "label": "Boy’s" }, { "value": "girls", "label": "Girl’s" }], "default": "boys" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sweaters" },
        { "type": "text", "id": "count", "label": "Product count", "default": "25" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "image_url", "label": "Image URL fallback" },
        { "type": "url", "id": "link", "label": "Link fallback" }
      ]
    }
  ],
  "presets": [{ "name": "Pebble categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
