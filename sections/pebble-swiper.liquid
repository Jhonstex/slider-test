{%- assign slider_id = 'pebble-swiper-' | append: section.id -%}
{%- assign pebble_font = section.settings.font_family -%}
{%- assign pebble_font_bold = pebble_font | font_modify: 'weight', '700' -%}

{% style %}
  {{ pebble_font | font_face: font_display: 'swap' }}
  {{ pebble_font_bold | font_face: font_display: 'swap' }}
  #{{ slider_id }} {
    --pebble-font-family: {{ pebble_font.family }}, {{ pebble_font.fallback_families }};
  }
{% endstyle %}

<section
  id="{{ slider_id }}"
  class="pebble-swiper pebble-swiper--{{ section.settings.content_position }} pebble-swiper--mobile-{{ section.settings.mobile_content_position }}"
  data-pebble-swiper
  data-autoplay="{{ section.settings.autoplay }}"
  data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-speed="{{ section.settings.transition_speed }}"
  data-navigation="{{ section.settings.show_navigation }}"
  data-pagination="{{ section.settings.show_pagination }}"
  data-total="{{ section.blocks.size }}"
  style="--pebble-height: {{ section.settings.desktop_height }}px; --pebble-mobile-height: {{ section.settings.mobile_height }}px; --pebble-overlay: {{ section.settings.overlay_color }}; --pebble-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --pebble-content-width: {{ section.settings.content_width }}px; --pebble-slide-speed: {{ section.settings.transition_speed }}ms;"
>
  <div class="swiper pebble-swiper__container">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {%- assign desktop_image = block.settings.desktop_image -%}
        {%- assign mobile_image = block.settings.mobile_image | default: desktop_image -%}
        <article class="swiper-slide pebble-swiper__slide{% if forloop.first %} is-active{% endif %}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
          <div class="pebble-swiper__media">
            {% if block.settings.slide_link != blank %}<a class="pebble-swiper__media-link" href="{{ block.settings.slide_link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% endif %}
              {% if desktop_image != blank or block.settings.desktop_image_url != blank %}
                <picture>
                  {% if mobile_image != blank %}
                    <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 1600 }}">
                  {% elsif block.settings.mobile_image_url != blank %}
                    <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image_url | escape }}">
                  {% endif %}
                  {% if desktop_image != blank %}
                    {{ desktop_image | image_url: width: 3840 | image_tag: class: 'pebble-swiper__image', loading: 'lazy', sizes: '100vw', alt: block.settings.alt_text }}
                  {% else %}
                    <img class="pebble-swiper__image" src="{{ block.settings.desktop_image_url | escape }}" alt="{{ block.settings.alt_text | escape }}" loading="lazy" width="6000" height="3125" sizes="100vw">
                  {% endif %}
                </picture>
              {% else %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'pebble-swiper__placeholder' }}
              {% endif %}
            {% if block.settings.slide_link != blank %}</a>{% endif %}
            <span class="pebble-swiper__overlay" aria-hidden="true"></span>
          </div>

          <div class="pebble-swiper__content-wrap">
            <div class="pebble-swiper__content" style="--pebble-text-color: {{ block.settings.text_color }};">
              {% if block.settings.eyebrow != blank %}<p class="pebble-swiper__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              {% if block.settings.heading != blank %}<h2 class="pebble-swiper__heading">{{ block.settings.heading }}{% if block.settings.heading_second_line != blank %}<br>{{ block.settings.heading_second_line }}{% endif %}</h2>{% endif %}
              {% if block.settings.body != blank %}<div class="pebble-swiper__body rte">{{ block.settings.body }}</div>{% endif %}
              {% if block.settings.button_label != blank %}
                <a class="pebble-swiper__button" href="{{ block.settings.button_link | default: '#' }}">
                  <span class="pebble-swiper__button-label">{{ block.settings.button_label }}</span>
                  <span class="pebble-swiper__button-reveal" aria-hidden="true">
                    <span class="pebble-swiper__button-reveal-label">{{ block.settings.button_label }}</span>
                    <span class="pebble-swiper__button-icon">{% render 'pebble-arrow' %}</span>
                  </span>
                </a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="pebble-swiper__controls">
      <div class="pebble-swiper__counter" data-pebble-counter aria-live="polite"><span data-pebble-current>1</span><span aria-hidden="true">/</span><span data-pebble-total>{{ section.blocks.size }}</span></div>
      {% if section.settings.show_pagination %}<div class="pebble-swiper__progress" aria-hidden="true"><span data-pebble-progress></span></div>{% endif %}
      {% if section.settings.show_navigation %}
        <div class="pebble-swiper__navigation">
          <button class="swiper-button-prev" type="button" aria-label="Previous slide"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 16.25 6.25 10l6.25-6.25"/></svg></button>
          <button class="swiper-button-next" type="button" aria-label="Next slide"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 3.75 6.25 6.25-6.25 6.25"/></svg></button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
.section-pebble-swiper {
  width: 100vw;
  max-width: none;
  margin-inline: calc(50% - 50vw);
  overflow: clip;
}

.pebble-swiper {
  --pebble-page-padding: 16px;
  --pebble-content-top-offset: 110px;
  width: 100%;
  max-width: none;
  color: var(--pebble-text-color, #fff);
  background: #d7d7d7;
  font-family: var(--pebble-font-family, Arial, sans-serif);
}

.pebble-swiper__container,
.pebble-swiper .swiper-wrapper {
  width: 100%;
  max-width: none;
  height: min(var(--pebble-height), 52.083333vw, 100dvh);
}

.pebble-swiper__container {
  position: relative;
  overflow: hidden;
  cursor: grab;
  touch-action: pan-y;
}

.pebble-swiper.is-dragging .pebble-swiper__container {
  cursor: grabbing;
  user-select: none;
}

.pebble-swiper .swiper-wrapper {
  position: relative;
}

.pebble-swiper__slide {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  visibility: visible;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--pebble-slide-speed) linear;
  will-change: opacity;
}

.pebble-swiper__slide.is-active {
  z-index: 1;
  opacity: 1;
  pointer-events: auto;
}

.pebble-swiper__slide.is-drag-target {
  z-index: 2;
  pointer-events: none;
}

.pebble-swiper.is-dragging .pebble-swiper__slide {
  transition: none;
}

.pebble-swiper__media,
.pebble-swiper__media-link,
.pebble-swiper__media picture,
.pebble-swiper__image,
.pebble-swiper__placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.pebble-swiper__media {
  position: absolute;
  inset: 0;
  width: 100%;
  max-width: none;
  opacity: 1;
  transition: opacity var(--pebble-slide-speed) linear;
  will-change: opacity;
}

.pebble-swiper__media-link {
  position: relative;
  z-index: 1;
}

.pebble-swiper__image,
.pebble-swiper__placeholder {
  object-fit: cover;
  transform: scale(1.15);
  transition: transform 1.3s cubic-bezier(.16, 1, .3, 1), opacity .35s ease-in-out;
  will-change: transform;
}

.pebble-swiper .is-active .pebble-swiper__image,
.pebble-swiper .is-active .pebble-swiper__placeholder { transform: scale(1); }

.pebble-swiper__placeholder {
  background: #cfcfcf;
}

.pebble-swiper__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: var(--pebble-overlay);
  opacity: var(--pebble-overlay-opacity);
}

.pebble-swiper__content-wrap {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  width: 100%;
  height: calc(100% - 84px - var(--pebble-content-top-offset));
  margin-top: var(--pebble-content-top-offset);
  padding: 40px var(--pebble-page-padding);
  opacity: 1;
  transition: opacity var(--pebble-slide-speed) linear;
  will-change: opacity;
}

.pebble-swiper.is-dragging .pebble-swiper__media,
.pebble-swiper.is-dragging .pebble-swiper__content-wrap {
  transition: none;
}

.pebble-swiper--left .pebble-swiper__content-wrap { justify-content: flex-start; }
.pebble-swiper--center .pebble-swiper__content-wrap { justify-content: center; }
.pebble-swiper--right .pebble-swiper__content-wrap { justify-content: flex-end; }

.pebble-swiper__content {
  width: fit-content;
  max-width: min(100%, var(--pebble-content-width));
  color: var(--pebble-text-color, #fff);
}

.pebble-swiper__eyebrow,
.pebble-swiper__heading,
.pebble-swiper__body,
.pebble-swiper__button {
  opacity: 0;
  transform: translateY(25px);
  transition-property: opacity, transform;
  transition-duration: 1.5s, 1.5s;
  transition-timing-function: cubic-bezier(.16, 1, .3, 1);
}

.pebble-swiper .is-active .pebble-swiper__eyebrow,
.pebble-swiper .is-active .pebble-swiper__heading,
.pebble-swiper .is-active .pebble-swiper__body,
.pebble-swiper .is-active .pebble-swiper__button {
  opacity: 1;
  transform: translateY(0);
}

.pebble-swiper .is-drag-target .pebble-swiper__eyebrow,
.pebble-swiper .is-drag-target .pebble-swiper__heading,
.pebble-swiper .is-drag-target .pebble-swiper__body,
.pebble-swiper .is-drag-target .pebble-swiper__button {
  opacity: 1;
  transform: translateY(0);
  transition: none;
}

.pebble-swiper .is-active .pebble-swiper__eyebrow { transition-delay: 50ms; }
.pebble-swiper .is-active .pebble-swiper__heading { transition-delay: 150ms; }
.pebble-swiper .is-active .pebble-swiper__body { transition-delay: 250ms; }
.pebble-swiper .is-active .pebble-swiper__button { transition-delay: 250ms; }

.pebble-swiper__eyebrow {
  margin: 0 0 16px;
  font-size: 15px;
  font-weight: 700;
  line-height: 24px;
  letter-spacing: normal;
  text-transform: uppercase;
}

.pebble-swiper__heading {
  max-width: 360px;
  margin: 0 0 clamp(24px, calc(1.163vw + 15.08px), 32px);
  font-family: var(--pebble-font-family, Arial, sans-serif);
  font-size: clamp(38px, calc(5.848vw - 6.85px), 68px);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: normal;
}

.pebble-swiper__body {
  max-width: 460px;
  margin: 24px 0 0;
  font-size: clamp(14px, 1.25vw, 20px);
  line-height: 1.5;
}

.pebble-swiper__button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 50px;
  width: auto;
  margin-top: 0;
  padding: 10px 48px 10px 24px;
  border: 1px solid transparent;
  border-radius: 60px;
  overflow: hidden;
  background: #fff;
  color: #000;
  font-family: var(--pebble-font-family, Arial, sans-serif);
  font-size: 15px;
  font-weight: 700;
  line-height: 24px;
  white-space: nowrap;
  text-decoration: none;
  text-transform: capitalize;
  isolation: isolate;
}

.pebble-swiper__button-label,
.pebble-swiper__button-reveal-label {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pebble-swiper__button-reveal {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  height: 100%;
  padding: 0 10px 0 24px;
  overflow: hidden;
  background: #000;
  color: #fff;
  clip-path: circle(15px at calc(100% - 25px) 50%);
  transition: clip-path .6s cubic-bezier(.4, 0, .2, 1);
}

.pebble-swiper__button-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 30px;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  color: #fff;
  overflow: hidden;
  transition: transform .35s ease-in-out;
}

.pebble-swiper__button svg { width: 12px; height: 12px; }

@keyframes pebble-button-arrow {
  0% { transform: translateX(0); }
  50% { transform: translateX(20px); }
  50.001% { transform: translateX(-20px); }
  100% { transform: translateX(0); }
}

@media (hover: hover) and (pointer: fine) {
  .pebble-swiper__button:hover .pebble-swiper__button-reveal {
    clip-path: circle(150% at calc(100% - 25px) 50%);
  }
  .pebble-swiper__button:hover .pebble-swiper__button-icon svg {
    animation: pebble-button-arrow 1s infinite;
  }
}

.pebble-swiper__button:focus-visible .pebble-swiper__button-reveal {
  clip-path: circle(150% at calc(100% - 25px) 50%);
}

.pebble-swiper__controls {
  position: absolute;
  right: var(--pebble-page-padding);
  bottom: 60px;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #fff;
}

.pebble-swiper__counter {
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 500;
  line-height: 24px;
}

.pebble-swiper__progress {
  position: relative;
  width: clamp(100px, 10vw, 140px);
  height: 2px;
  overflow: hidden;
  background: rgb(255 255 255 / 10%);
}

.pebble-swiper__progress span {
  position: absolute;
  inset: 0;
  background: #fff;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
}

.pebble-swiper__navigation { display: flex; align-items: center; gap: 8px; }
.pebble-swiper .swiper-button-prev,
.pebble-swiper .swiper-button-next {
  position: static;
  display: grid;
  width: 16px;
  height: 16px;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: currentColor;
  place-items: center;
}
.pebble-swiper .swiper-button-prev::after,
.pebble-swiper .swiper-button-next::after { display: none; }
.pebble-swiper .swiper-button-prev svg,
.pebble-swiper .swiper-button-next svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

@media (min-width: 1200px) {
  .pebble-swiper { --pebble-page-padding: 50px; }
}

@media (min-width: 1536px) {
  .pebble-swiper { --pebble-page-padding: max(135px, calc(50vw - 7.5px - 720px)); }
}

@media (max-width: 767px) {
  .pebble-swiper { --pebble-content-top-offset: 90px; }
  .pebble-swiper__container,
  .pebble-swiper .swiper-wrapper { height: min(var(--pebble-mobile-height), 154.666667vw, 100dvh); }
  .pebble-swiper__content-wrap {
    align-items: flex-end;
    height: calc(100% - 84px - var(--pebble-content-top-offset));
    padding: 24px 16px;
  }
  .pebble-swiper__content { width: 100%; }
  .pebble-swiper--mobile-left .pebble-swiper__content { text-align: left; }
  .pebble-swiper--mobile-center .pebble-swiper__content { text-align: center; }
  .pebble-swiper--mobile-right .pebble-swiper__content { text-align: right; }
  .pebble-swiper--mobile-left .pebble-swiper__eyebrow,
  .pebble-swiper--mobile-left .pebble-swiper__heading { margin-right: auto; margin-left: 0; }
  .pebble-swiper--mobile-center .pebble-swiper__eyebrow,
  .pebble-swiper--mobile-center .pebble-swiper__heading { margin-right: auto; margin-left: auto; }
  .pebble-swiper--mobile-right .pebble-swiper__eyebrow,
  .pebble-swiper--mobile-right .pebble-swiper__heading { margin-right: 0; margin-left: auto; }
  .pebble-swiper__heading { max-width: 210px; margin-bottom: 24px; font-size: 38px; }
  .pebble-swiper__body { font-size: 15px; }
  .pebble-swiper__button { width: 100%; justify-content: space-between; text-align: left; }
  .pebble-swiper__controls { right: 16px; bottom: 24px; left: 16px; gap: 12px; }
  .pebble-swiper__counter { gap: 4px; font-size: 15px; }
  .pebble-swiper__progress { flex: 1 1 auto; width: auto; }
  .pebble-swiper__navigation { gap: 8px; }
  .pebble-swiper .swiper-button-prev,
  .pebble-swiper .swiper-button-next { width: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .pebble-swiper__media,
  .pebble-swiper__image,
  .pebble-swiper__placeholder,
  .pebble-swiper__eyebrow,
  .pebble-swiper__heading,
  .pebble-swiper__body,
  .pebble-swiper__button,
  .pebble-swiper__button-reveal { transition: none; }
  .pebble-swiper__image,
  .pebble-swiper__placeholder { transform: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function initPebbleSlider(root) {
    if (root.dataset.pebbleReady === 'true') return;
    root.dataset.pebbleReady = 'true';
    var slides = Array.prototype.slice.call(root.querySelectorAll('.pebble-swiper__slide'));
    if (!slides.length) return;
    var autoplay = root.dataset.autoplay === 'true';
    var delay = Number(root.dataset.delay) || 5000;
    var speed = Number(root.dataset.speed) || 300;
    var activeIndex = Math.max(0, slides.findIndex(function (slide) { return slide.classList.contains('is-active'); }));
    var current = root.querySelector('[data-pebble-current]');
    var total = root.querySelector('[data-pebble-total]');
    var progressBar = root.querySelector('[data-pebble-progress]');
    var previousButton = root.querySelector('.swiper-button-prev');
    var nextButton = root.querySelector('.swiper-button-next');
    var progressAnimationFrame = null;
    var autoplayTimer = null;
    var resizeTimer = null;
    var dragResetTimer = null;
    var dragPointerId = null;
    var dragTargetIndex = -1;
    var dragProgress = 0;
    var dragStartedAt = 0;
    var pointerStartX = 0;
    var pointerStartY = 0;
    var pointerLastX = 0;
    var pointerLastY = 0;
    function animateProgress() {
      if (!progressBar || !autoplay) return;
      if (progressAnimationFrame !== null) window.cancelAnimationFrame(progressAnimationFrame);
      progressBar.style.transition = 'none';
      progressBar.style.transform = 'translate3d(0, 0, 0) scaleX(0)';
      progressAnimationFrame = window.requestAnimationFrame(function () {
        progressAnimationFrame = window.requestAnimationFrame(function () {
          progressAnimationFrame = null;
          progressBar.style.transition = 'transform ' + delay + 'ms linear';
          progressBar.style.transform = 'translate3d(0, 0, 0) scaleX(1)';
        });
      });
    }
    function updateCounter() {
      if (current) current.textContent = String(activeIndex + 1);
      if (total) total.textContent = String(slides.length);
    }
    function scheduleAutoplay() {
      if (autoplayTimer !== null) window.clearTimeout(autoplayTimer);
      if (!autoplay || slides.length < 2) return;
      autoplayTimer = window.setTimeout(function () {
        showSlide(activeIndex + 1, false);
      }, delay);
    }
    function pauseAutoplay() {
      if (autoplayTimer !== null) {
        window.clearTimeout(autoplayTimer);
        autoplayTimer = null;
      }
      if (progressAnimationFrame !== null) {
        window.cancelAnimationFrame(progressAnimationFrame);
        progressAnimationFrame = null;
      }
      if (progressBar) {
        var progressTransform = window.getComputedStyle(progressBar).transform;
        progressBar.style.transition = 'none';
        progressBar.style.transform = progressTransform;
      }
    }
    function stopAutoplay() {
      pauseAutoplay();
      autoplay = false;
    }
    function restartAutoplay() {
      if (!autoplay || slides.length < 2) return;
      animateProgress();
      scheduleAutoplay();
    }
    function clearDragReset() {
      if (dragResetTimer !== null) {
        window.clearTimeout(dragResetTimer);
        dragResetTimer = null;
      }
    }
    function getDragLayers(slide) {
      return [
        slide.querySelector('.pebble-swiper__media'),
        slide.querySelector('.pebble-swiper__content-wrap')
      ];
    }
    function setDragOpacity(slide, opacity) {
      slide.style.opacity = '1';
      getDragLayers(slide).forEach(function (layer) {
        if (layer) layer.style.opacity = String(opacity);
      });
    }
    function clearDragOpacity(slide) {
      slide.style.removeProperty('opacity');
      getDragLayers(slide).forEach(function (layer) {
        if (layer) layer.style.removeProperty('opacity');
      });
    }
    function clearDragStyles() {
      slides.forEach(function (slide) {
        slide.classList.remove('is-drag-target');
        clearDragOpacity(slide);
      });
      root.classList.remove('is-dragging');
    }
    function normalizeIndex(index) {
      return (index % slides.length + slides.length) % slides.length;
    }
    function setDragTarget(direction) {
      var nextTargetIndex = normalizeIndex(activeIndex + direction);
      if (nextTargetIndex === dragTargetIndex) return;
      if (dragTargetIndex >= 0) {
        slides[dragTargetIndex].classList.remove('is-drag-target');
        clearDragOpacity(slides[dragTargetIndex]);
      }
      dragTargetIndex = nextTargetIndex;
      slides[dragTargetIndex].classList.add('is-drag-target');
      setDragOpacity(slides[dragTargetIndex], 0);
    }
    function renderDrag(distanceX) {
      var sliderWidth = root.getBoundingClientRect().width || 1;
      var direction = distanceX < 0 ? 1 : -1;
      setDragTarget(direction);
      dragProgress = Math.min(Math.abs(distanceX) / sliderWidth, 1);
      setDragOpacity(slides[activeIndex], 1 - dragProgress);
      setDragOpacity(slides[dragTargetIndex], dragProgress);
    }
    function settleDrag(advance) {
      var previousIndex = activeIndex;
      var targetIndex = dragTargetIndex;
      root.classList.remove('is-dragging');
      clearDragReset();
      if (advance && targetIndex >= 0) {
        slides[previousIndex].classList.remove('is-active');
        slides[previousIndex].setAttribute('aria-hidden', 'true');
        activeIndex = targetIndex;
        slides[activeIndex].classList.add('is-active');
        slides[activeIndex].classList.remove('is-drag-target');
        slides[activeIndex].setAttribute('aria-hidden', 'false');
        window.requestAnimationFrame(function () {
