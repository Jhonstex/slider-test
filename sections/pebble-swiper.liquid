{%- assign slider_id = 'pebble-swiper-' | append: section.id -%}
<link rel="preload" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"></noscript>

<section
  id="{{ slider_id }}"
  class="pebble-swiper pebble-swiper--{{ section.settings.content_position }} pebble-swiper--mobile-{{ section.settings.mobile_content_position }}"
  data-pebble-swiper
  data-autoplay="{{ section.settings.autoplay }}"
  data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-speed="{{ section.settings.transition_speed }}"
  data-navigation="{{ section.settings.show_navigation }}"
  data-pagination="{{ section.settings.show_pagination }}"
  data-total="{{ section.blocks.size }}"
  style="--pebble-height: {{ section.settings.desktop_height }}px; --pebble-mobile-height: {{ section.settings.mobile_height }}px; --pebble-overlay: {{ section.settings.overlay_color }}; --pebble-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --pebble-content-width: {{ section.settings.content_width }}px; --pebble-motion-speed: {{ section.settings.transition_speed }}ms;"
>
  <div class="swiper pebble-swiper__container">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {%- assign desktop_image = block.settings.desktop_image -%}
        {%- assign mobile_image = block.settings.mobile_image | default: desktop_image -%}
        <article class="swiper-slide pebble-swiper__slide" {{ block.shopify_attributes }}>
          <div class="pebble-swiper__media">
            {% if block.settings.slide_link != blank %}<a class="pebble-swiper__media-link" href="{{ block.settings.slide_link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% endif %}
              {% if desktop_image != blank or block.settings.desktop_image_url != blank %}
                <picture>
                  {% if mobile_image != blank %}
                    <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1600 }}">
                  {% elsif block.settings.mobile_image_url != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image_url | escape }}">
                  {% endif %}
                  {% if desktop_image != blank %}
                    {{ desktop_image | image_url: width: 2800 | image_tag: class: 'pebble-swiper__image', loading: 'lazy', alt: block.settings.alt_text }}
                  {% else %}
                    <img class="pebble-swiper__image" src="{{ block.settings.desktop_image_url | escape }}" alt="{{ block.settings.alt_text | escape }}" loading="lazy" width="2800" height="1200">
                  {% endif %}
                </picture>
              {% else %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'pebble-swiper__placeholder' }}
              {% endif %}
            {% if block.settings.slide_link != blank %}</a>{% endif %}
            <span class="pebble-swiper__overlay" aria-hidden="true"></span>
          </div>

          <div class="pebble-swiper__content-wrap">
            <div class="pebble-swiper__content" style="--pebble-text-color: {{ block.settings.text_color }};">
              {% if block.settings.eyebrow != blank %}<p class="pebble-swiper__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              {% if block.settings.heading != blank %}<h2 class="pebble-swiper__heading">{{ block.settings.heading }}{% if block.settings.heading_second_line != blank %}<br>{{ block.settings.heading_second_line }}{% endif %}</h2>{% endif %}
              {% if block.settings.body != blank %}<div class="pebble-swiper__body rte">{{ block.settings.body }}</div>{% endif %}
              {% if block.settings.button_label != blank %}
                <a class="pebble-swiper__button" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}<span aria-hidden="true">{% render 'pebble-arrow' %}</span></a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="pebble-swiper__controls">
      <div class="pebble-swiper__counter" data-pebble-counter aria-live="polite"><span data-pebble-current>1</span><span aria-hidden="true">/</span><span data-pebble-total>{{ section.blocks.size }}</span></div>
      {% if section.settings.show_pagination %}<div class="pebble-swiper__progress" aria-hidden="true"><span data-pebble-progress></span></div>{% endif %}
      {% if section.settings.show_navigation %}
        <div class="pebble-swiper__navigation">
          <button class="swiper-button-prev" type="button" aria-label="Previous slide"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 16.25 6.25 10l6.25-6.25"/></svg></button>
          <button class="swiper-button-next" type="button" aria-label="Next slide"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 3.75 6.25 6.25-6.25 6.25"/></svg></button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

{% stylesheet %}
@font-face {
  font-family: 'Pebble Bricolage Grotesque';
  src: url('https://pebble-little.myshopify.com/cdn/fonts/bricolage_grotesque/bricolagegrotesque_n5.8c091e52a78b3e58ef96221ce55140a80a8253ff.woff2') format('woff2');
  font-style: normal;
  font-weight: 500;
  font-display: swap;
}

@font-face {
  font-family: 'Pebble Bricolage Grotesque';
  src: url('https://pebble-little.myshopify.com/cdn/fonts/bricolage_grotesque/bricolagegrotesque_n7.de5675dd7a8e145fdc4cb2cfe67a16cb085528d0.woff2') format('woff2');
  font-style: normal;
  font-weight: 700;
  font-display: swap;
}

.pebble-swiper {
  width: 100%;
  color: var(--pebble-text-color, #fff);
  background: #d7d7d7;
  font-family: 'Pebble Bricolage Grotesque', Arial, sans-serif;
}

.pebble-swiper__container,
.pebble-swiper .swiper-wrapper,
.pebble-swiper .swiper-slide {
  height: min(var(--pebble-height), 52.083vw);
}

.pebble-swiper__slide {
  position: relative;
  overflow: hidden;
}

.pebble-swiper__media,
.pebble-swiper__media-link,
.pebble-swiper__media picture,
.pebble-swiper__image,
.pebble-swiper__placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.pebble-swiper__media {
  position: absolute;
  inset: 0 -5%;
  transform: translate3d(var(--pebble-slide-shift, 0px), 0, 0);
  transition: transform var(--pebble-motion-speed) cubic-bezier(.22, 1, .36, 1);
  will-change: transform;
}

.pebble-swiper.is-dragging .pebble-swiper__media { transition: none; }

.pebble-swiper__media-link {
  position: relative;
  z-index: 1;
}

.pebble-swiper__image,
.pebble-swiper__placeholder {
  object-fit: cover;
  transform: scale(1.035);
  transition: transform 1.1s cubic-bezier(.22, 1, .36, 1), opacity .35s ease-in-out;
}

.pebble-swiper .swiper-slide-active .pebble-swiper__image,
.pebble-swiper .swiper-slide-active .pebble-swiper__placeholder { transform: scale(1); }

.pebble-swiper__placeholder {
  background: #cfcfcf;
}

.pebble-swiper__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: var(--pebble-overlay);
  opacity: var(--pebble-overlay-opacity);
}

.pebble-swiper__content-wrap {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 24px clamp(32px, 4.167vw, 80px) 0;
}

.pebble-swiper--left .pebble-swiper__content-wrap { justify-content: flex-start; }
.pebble-swiper--center .pebble-swiper__content-wrap { justify-content: center; }
.pebble-swiper--right .pebble-swiper__content-wrap { justify-content: flex-end; }

.pebble-swiper__content {
  width: min(100%, var(--pebble-content-width));
  color: var(--pebble-text-color, #fff);
}

.pebble-swiper__eyebrow,
.pebble-swiper__heading,
.pebble-swiper__body,
.pebble-swiper__button {
  opacity: 0;
  transform: translateY(28px);
  transition-property: opacity, transform;
  transition-duration: var(--pebble-motion-speed), var(--pebble-motion-speed);
  transition-timing-function: cubic-bezier(.22, 1, .36, 1);
}

.pebble-swiper .swiper-slide-active .pebble-swiper__eyebrow,
.pebble-swiper .swiper-slide-active .pebble-swiper__heading,
.pebble-swiper .swiper-slide-active .pebble-swiper__body,
.pebble-swiper .swiper-slide-active .pebble-swiper__button {
  opacity: 1;
  transform: translateY(0);
}

.pebble-swiper .swiper-slide-active .pebble-swiper__eyebrow { transition-delay: 120ms; }
.pebble-swiper .swiper-slide-active .pebble-swiper__heading { transition-delay: 200ms; }
.pebble-swiper .swiper-slide-active .pebble-swiper__body { transition-delay: 280ms; }
.pebble-swiper .swiper-slide-active .pebble-swiper__button { transition-delay: 360ms; }

.pebble-swiper__eyebrow {
  margin: 0 0 16px;
  font-size: 15px;
  font-weight: 700;
  line-height: 24px;
  letter-spacing: normal;
  text-transform: uppercase;
}

.pebble-swiper__heading {
  max-width: 360px;
  margin: 0 0 clamp(24px, calc(1.163vw + 15.08px), 32px);
  font-family: 'Pebble Bricolage Grotesque', Arial, sans-serif;
  font-size: clamp(38px, calc(5.848vw - 6.85px), 68px);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: normal;
}

.pebble-swiper__body {
  max-width: 460px;
  margin: 24px 0 0;
  font-size: clamp(14px, 1.25vw, 20px);
  line-height: 1.5;
}

.pebble-swiper__button {
  display: inline-flex;
  align-items: center;
  gap: 0;
  min-width: 260px;
  min-height: 60px;
  margin-top: 0;
  padding: 0 14px 0 34px;
  border-radius: 999px;
  background: #fff;
  color: #242424;
  font-family: 'Pebble Bricolage Grotesque', Arial, sans-serif;
  font-size: 18px;
  font-weight: 700;
  line-height: 24px;
  text-decoration: none;
  text-transform: capitalize;
}

.pebble-swiper__button span {
  display: grid;
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  margin-left: auto;
  border-radius: 50%;
  background: #242424;
  color: #fff;
  place-items: center;
}

.pebble-swiper__button svg { width: 16px; height: 16px; }
.pebble-swiper__button:hover { transform: translateY(-2px); background: #f5f5f5; }

.pebble-swiper__controls {
  position: absolute;
  right: clamp(32px, 4.167vw, 80px);
  bottom: 60px;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #fff;
}

.pebble-swiper__counter {
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 500;
  line-height: 24px;
}

.pebble-swiper__progress {
  position: relative;
  width: clamp(100px, 10vw, 140px);
  height: 2px;
  overflow: hidden;
  background: rgb(255 255 255 / 20%);
}

.pebble-swiper__progress span {
  position: absolute;
  inset: 0;
  background: #fff;
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
}

.pebble-swiper__navigation { display: flex; align-items: center; gap: 8px; }
.pebble-swiper .swiper-button-prev,
.pebble-swiper .swiper-button-next {
  position: static;
  display: grid;
  width: 16px;
  height: 16px;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: currentColor;
  place-items: center;
}
.pebble-swiper .swiper-button-prev::after,
.pebble-swiper .swiper-button-next::after { display: none; }
.pebble-swiper .swiper-button-prev svg,
.pebble-swiper .swiper-button-next svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

@media (max-width: 749px) {
  .pebble-swiper__container,
  .pebble-swiper .swiper-wrapper,
  .pebble-swiper .swiper-slide { height: var(--pebble-mobile-height); }
  .pebble-swiper__content-wrap {
    align-items: flex-end;
    height: calc(100% - 64px);
    padding: 24px 16px;
  }
  .pebble-swiper__content { width: 100%; }
  .pebble-swiper--mobile-left .pebble-swiper__content { text-align: left; }
  .pebble-swiper--mobile-center .pebble-swiper__content { text-align: center; }
  .pebble-swiper--mobile-right .pebble-swiper__content { text-align: right; }
  .pebble-swiper--mobile-left .pebble-swiper__eyebrow,
  .pebble-swiper--mobile-left .pebble-swiper__heading { margin-right: auto; margin-left: 0; }
  .pebble-swiper--mobile-center .pebble-swiper__eyebrow,
  .pebble-swiper--mobile-center .pebble-swiper__heading { margin-right: auto; margin-left: auto; }
  .pebble-swiper--mobile-right .pebble-swiper__eyebrow,
  .pebble-swiper--mobile-right .pebble-swiper__heading { margin-right: 0; margin-left: auto; }
  .pebble-swiper__heading { max-width: 210px; margin-bottom: 24px; font-size: 38px; }
  .pebble-swiper__body { font-size: 15px; }
  .pebble-swiper__button { width: 100%; min-width: 0; justify-content: flex-start; text-align: left; }
  .pebble-swiper__button span { margin-left: auto; }
  .pebble-swiper__controls { right: 16px; bottom: 40px; left: 16px; gap: 12px; }
  .pebble-swiper__counter { gap: 4px; font-size: 15px; }
  .pebble-swiper__progress { flex: 1 1 auto; width: auto; }
  .pebble-swiper__navigation { gap: 8px; }
  .pebble-swiper .swiper-button-prev,
  .pebble-swiper .swiper-button-next { width: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .pebble-swiper__media,
  .pebble-swiper__image,
  .pebble-swiper__placeholder,
  .pebble-swiper__eyebrow,
  .pebble-swiper__heading,
  .pebble-swiper__body,
  .pebble-swiper__button { transition: none; }
  .pebble-swiper__media { transform: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function initPebbleSlider(root) {
    if (root.dataset.pebbleReady === 'true' || typeof Swiper === 'undefined') return;
    root.dataset.pebbleReady = 'true';
    var autoplay = root.dataset.autoplay === 'true';
    var options = {
      slidesPerView: 1,
      loop: root.querySelectorAll('.swiper-slide').length > 1,
      speed: Number(root.dataset.speed) || 700,
      effect: 'fade',
      fadeEffect: { crossFade: true },
      simulateTouch: true,
      followFinger: true,
      grabCursor: true,
      watchSlidesProgress: true,
      watchOverflow: true,
      a11y: { enabled: true },
      keyboard: { enabled: true }
    };
    if (autoplay) options.autoplay = { delay: Number(root.dataset.delay) || 6000, disableOnInteraction: false, pauseOnMouseEnter: true };
    if (root.dataset.navigation === 'true') options.navigation = { nextEl: root.querySelector('.swiper-button-next'), prevEl: root.querySelector('.swiper-button-prev') };
    var slider = new Swiper(root.querySelector('.swiper'), options);
    var current = root.querySelector('[data-pebble-current]');
    var total = root.querySelector('[data-pebble-total]');
    var progressBar = root.querySelector('[data-pebble-progress]');
    function updateDirectionalMotion(instance) {
      var distance = Math.min(root.clientWidth * 0.04, 72);
      instance.slides.forEach(function (slide) {
        var progress = Number.isFinite(slide.progress) ? slide.progress : 0;
        progress = Math.max(-1, Math.min(1, progress));
        slide.style.setProperty('--pebble-slide-shift', progress * distance + 'px');
      });
    }
    function updateCounter(instance) {
      var value = String(instance.realIndex + 1);
      if (current) current.textContent = value;
      if (total) total.textContent = String(root.dataset.total || instance.slides.length);
    }
    slider.on('slideChange', function () {
      updateCounter(slider);
      if (progressBar) progressBar.style.transform = 'scaleX(0)';
    });
    slider.on('setTranslate', function () {
      updateDirectionalMotion(slider);
    });
    slider.on('touchStart', function () {
      root.classList.add('is-dragging');
    });
    slider.on('touchEnd', function () {
      root.classList.remove('is-dragging');
      updateDirectionalMotion(slider);
    });
    slider.on('transitionEnd', function () {
      root.classList.remove('is-dragging');
      updateDirectionalMotion(slider);
    });
    slider.on('resize', function () {
      updateDirectionalMotion(slider);
    });
    slider.on('autoplayTimeLeft', function (_instance, _timeLeft, progress) {
      if (progressBar) progressBar.style.transform = 'scaleX(' + (1 - progress) + ')';
    });
    if (!autoplay && progressBar) progressBar.style.transform = 'scaleX(1)';
    updateDirectionalMotion(slider);
    updateCounter(slider);
  }
  function boot() {
    if (typeof Swiper === 'undefined') {
      window.setTimeout(boot, 80);
      return;
    }
    document.querySelectorAll('[data-pebble-swiper]').forEach(initPebbleSlider);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', function (event) {
    var root = event.target.querySelector?.('[data-pebble-swiper]');
    if (root) initPebbleSlider(root);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Pebble slideshow",
  "tag": "section",
  "class": "section-pebble-swiper",
  "settings": [
    { "type": "range", "id": "desktop_height", "label": "Desktop max height", "min": 620, "max": 1200, "step": 10, "unit": "px", "default": 1040 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 520, "max": 900, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 280, "max": 760, "step": 10, "unit": "px", "default": 520 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "mobile_content_position", "label": "Mobile content position", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": true },
    { "type": "range", "id": "autoplay_delay", "label": "Autoplay delay", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "transition_speed", "label": "Transition speed", "min": 300, "max": 1600, "step": 100, "unit": "ms", "default": 700 },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": true },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "url", "id": "desktop_image_url", "label": "Desktop image URL fallback" },
        { "type": "url", "id": "mobile_image_url", "label": "Mobile image URL fallback" },
        { "type": "text", "id": "alt_text", "label": "Image alt text", "default": "Slideshow image" },
        { "type": "url", "id": "slide_link", "label": "Slide link" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open slide link in new tab", "default": false },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New campaign" },
        { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Softness" },
        { "type": "text", "id": "heading_second_line", "label": "Heading line 2", "default": "in Comfort" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Collection" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pebble slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
