        {% assign originalProduct = product %}
        
        {% if product != blank and product.id != blank %}
          {% assign variant = product.selected_or_first_available_variant %}
          {% assign formId = 'beae-product-form-' | append: product.id %}
          {% form 'product', product, id: formId, class: 'form', style: 'width:100%;', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
