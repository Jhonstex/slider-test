{% assign image_index = 0 %}
<section class="about section-spacing" style="--about-bg: {{ section.settings.background }}; --about-gap: {{ section.settings.gap }}px;">
  <div class="page-width about__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'image' %}
          <div class="about__media about__media--{{ image_index }} reveal" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.alt | escape }}
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url | escape }}" width="1000" height="1000" loading="lazy" alt="{{ block.settings.alt | escape }}">
            {% else %}
              <div class="media-placeholder">Add an about image</div>
            {% endif %}
          </div>
          {% assign image_index = image_index | plus: 1 %}
        {% when 'content' %}
          <div class="about__content reveal" style="--about-content-bg: {{ block.settings.background }};" {{ block.shopify_attributes }}>
            {% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
            <h2>{{ block.settings.heading }}</h2>
            <div class="rte">{{ block.settings.body }}</div>
            {% if block.settings.button_label != blank %}<a class="button" href="{{ block.settings.button_link | default: routes.root_url }}">{{ block.settings.button_label }}</a>{% endif %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "gap", "label": "Column gap", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "limit": 2, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "image_url", "label": "Image URL" },
      { "type": "text", "id": "alt", "label": "Alt text", "default": "KITO about collection" }
    ] },
    { "type": "content", "name": "Content", "limit": 1, "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Big Love For Our Lovely Kids." },
      { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. Ut enim ad minim veniam, quis nostrud exercitation.</p>" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "color", "id": "background", "label": "Content background", "default": "#fff0f5" }
    ] }
  ],
  "presets": [{ "name": "About", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "content" }] }]
}
{% endschema %}

