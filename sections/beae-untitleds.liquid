<style>
  .random-banner-wrapper {
  position: relative;
  width: 100vw;
  max-width: none;
  height: 520px;
  overflow: hidden;
  margin-left: calc(50% - 50vw);
  background: #f3f3f3;
}

.random-banner-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

  .random-banner-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>

<script>
(function () {
  const images = [
    "https://cdn.shopify.com/s/files/1/0748/6704/8661/files/slide-1-friends-home_1dfyzzd.png?v=1785064555",
    "https://cdn.shopify.com/s/files/1/0748/6704/8661/files/slide-3-family-firm_1dq0c0i.png?v=1785064554",
    "https://cdn.shopify.com/s/files/1/0748/6704/8661/files/slide-2-investor_9ydf3b.png?v=1785064553"
  ];

  function shuffleArray(array) {
    const result = [...array];

    for (let i = result.length - 1; i > 0; i--) {
      const randomIndex = Math.floor(Math.random() * (i + 1));

      [result[i], result[randomIndex]] = [
        result[randomIndex],
        result[i]
      ];
    }

    return result;
  }

  function initializeRandomBanner() {
    const banner = document.getElementById("random-banner-test");

    if (!banner) {
      return;
    }

    banner.removeAttribute("srcset");
    banner.removeAttribute("sizes");
    banner.removeAttribute("data-src");
    banner.removeAttribute("data-srcset");
    banner.removeAttribute("data-sizes");
    banner.removeAttribute("loading");

    banner.classList.remove(
      "lazyload",
      "lazyloaded",
      "lazyloading"
    );

    banner.loading = "eager";

    const randomizedImages = shuffleArray(images);
    let currentAttempt = 0;

    function tryNextImage() {
      if (currentAttempt >= randomizedImages.length) {
        banner.style.display = "none";
        return;
      }

      const selectedImage = randomizedImages[currentAttempt];
      const preloadImage = new Image();

      preloadImage.onload = function () {
        banner.removeAttribute("srcset");
        banner.removeAttribute("data-src");
        banner.removeAttribute("data-srcset");

        banner.src = selectedImage;
        banner.style.display = "block";
      };

      preloadImage.onerror = function () {
        currentAttempt++;
        tryNextImage();
      };

      preloadImage.src = selectedImage;
    }

    tryNextImage();
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initializeRandomBanner
    );
  } else {
    initializeRandomBanner();
  }

  document.addEventListener(
    "shopify:section:load",
    initializeRandomBanner
  );
